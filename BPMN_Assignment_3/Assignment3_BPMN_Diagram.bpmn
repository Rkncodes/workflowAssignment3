      <bpmndi:BPMNShape id="End_SLA_di" bpmnElement="End_SLA"><dc:Bounds x="4372" y="867" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="4414" y="865" width="104" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Committee_di" bpmnElement="GW_Committee" isMarkerVisible="true"><dc:Bounds x="4475" y="760" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="4448" y="815" width="104" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejCommittee_di" bpmnElement="End_RejCommittee"><dc:Bounds x="4622" y="767" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="4588" y="808" width="104" height="53" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ApproveMerge_di" bpmnElement="GW_ApproveMerge" isMarkerVisible="true"><dc:Bounds x="4475" y="650" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Flag_di" bpmnElement="GW_Flag" isMarkerVisible="true"><dc:Bounds x="1395" y="980" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1336" y="1028" width="72" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Fraud_di" bpmnElement="SP_Fraud" isExpanded="false"><dc:Bounds x="1510" y="965" width="100" height="80" /></bpmndi:BPMNShape>
