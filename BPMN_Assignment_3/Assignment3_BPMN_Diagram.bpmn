<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Loan" targetNamespace="http://example.edu/bpmn/loan-origination" exporter="hand-authored BPMN 2.0 (bpmn.io compatible)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Loan">
    <bpmn:participant id="Participant_Bank" name="Bank – Loan Origination &amp; Approval" processRef="Process_Loan" />
    <bpmn:participant id="Participant_CreditBureau" name="Credit Bureau (external)" />
    <bpmn:messageFlow id="MessageFlow_BureauRequest" name="Credit report request" sourceRef="SP_Bureau" targetRef="Participant_CreditBureau" />
    <bpmn:messageFlow id="MessageFlow_BureauReport" name="Credit report" sourceRef="Participant_CreditBureau" targetRef="SP_Bureau" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Withdrawal" name="Application withdrawal" />
  <bpmn:message id="Msg_LapseNotice" name="Lapse notice" />
  <bpmn:message id="Msg_RejectionNotice" name="Rejection notice with reason code" />
  <bpmn:message id="Msg_SlaReminder" name="SLA reminder" />
  <bpmn:message id="Msg_OfferNotice" name="Offer status notice" />
  <bpmn:message id="Msg_WithdrawalConfirmation" name="Withdrawal confirmation" />
  <bpmn:error id="Error_BureauCall" name="Credit bureau call failed" errorCode="BUREAU_CALL_FAILED" />
  <bpmn:error id="Error_BureauUnavailable" name="Credit bureau unavailable" errorCode="BUREAU_UNAVAILABLE" />
  <bpmn:error id="Error_Disbursement" name="Disbursement failed" errorCode="DISBURSEMENT_FAILED" />
  <bpmn:process id="Process_Loan" name="Loan Origination &amp; Approval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start_Loan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MissTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LapsedDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LapsedCounter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_CounterResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_CounterTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CounterAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CounterDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_SignTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SigValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SignFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SignAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LoanOfficer" name="Loan Officer">
        <bpmn:flowNodeRef>UT_Income</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ManualKYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KYCRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KYCRej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ManualCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Collateral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Revalue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriter / Credit Committee">
        <bpmn:flowNodeRef>OR_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_UWMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WithdrawUW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_UWDec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejUW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Committee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Committee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ApproveMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fraud" name="Fraud &amp; Compliance Team">
        <bpmn:flowNodeRef>GW_Flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_SAR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_EDD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations / Disbursement">
        <bpmn:flowNodeRef>GW_HumanMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_VerifyAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DisbRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_HoldFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DisbFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoreBanking" name="Core Banking System">
        <bpmn:flowNodeRef>GW_DocMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Fee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_CompFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ReverseFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KYCDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Bureau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_BureauErr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ScoreMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Counter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_OfferMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recv_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_OfferTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WithdrawOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_WMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SignMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_CreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_CompAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ReverseAcct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DisbMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_DisbErr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Disbursed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Disbursed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Loan" name="Applicant needs a loan">
      <bpmn:outgoing>Flow_012_Loan_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UT_Submit" name="Submit Application &amp; Documents">
      <bpmn:incoming>Flow_012_Loan_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_013_Submit_DocMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_Missing" name="Provide Missing Documents">
      <bpmn:incoming>Flow_017_Docs_Missing</bpmn:incoming>
      <bpmn:outgoing>Flow_019_Missing_DocMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_MissTimer" name="7 days: no response" attachedToRef="UT_Missing">
      <bpmn:outgoing>Flow_020_MissTimer_LapsedDocs</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_MissTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_LapsedDocs" name="Application lapsed – documents not provided">
      <bpmn:incoming>Flow_020_MissTimer_LapsedDocs</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_LapsedDocs_def" messageRef="Msg_LapseNotice" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_LapsedCounter" name="Application lapsed – no reply to counter-offer">
      <bpmn:incoming>Flow_053_CounterTimer_LapsedCounter</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_LapsedCounter_def" messageRef="Msg_LapseNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_CounterResp" name="Accept or Decline Counter-Offer">
      <bpmn:incoming>Flow_052_Counter_CounterResp</bpmn:incoming>
      <bpmn:outgoing>Flow_054_CounterResp_CounterAcc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_CounterTimer" name="7 days: no response" attachedToRef="UT_CounterResp">
      <bpmn:outgoing>Flow_053_CounterTimer_LapsedCounter</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_CounterTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_CounterAcc" name="Counter-offer accepted?">
      <bpmn:incoming>Flow_054_CounterResp_CounterAcc</bpmn:incoming>
      <bpmn:outgoing>Flow_055_CounterAcc_ScoreMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_056_CounterAcc_CounterDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CounterDeclined" name="Closed – counter-offer declined">
      <bpmn:incoming>Flow_056_CounterAcc_CounterDeclined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Sign" name="E-Sign Loan Agreement">
      <bpmn:incoming>Flow_085_SignMerge_Sign</bpmn:incoming>
      <bpmn:outgoing>Flow_086_Sign_SigValid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_SignTimer" name="5 days: not signed" attachedToRef="UT_Sign">
      <bpmn:outgoing>Flow_089_SignTimer_SignFail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_SignTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_SigValid" name="Signature valid?">
      <bpmn:incoming>Flow_086_Sign_SigValid</bpmn:incoming>
      <bpmn:outgoing>Flow_087_SigValid_CreateAccount</bpmn:outgoing>
      <bpmn:outgoing>Flow_088_SigValid_SignFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SignFail">
      <bpmn:incoming>Flow_088_SigValid_SignFail</bpmn:incoming>
      <bpmn:incoming>Flow_089_SignTimer_SignFail</bpmn:incoming>
      <bpmn:outgoing>Flow_090_SignFail_SignAttempts</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SignAttempts" name="Signing attempts &lt; 2?">
      <bpmn:incoming>Flow_090_SignFail_SignAttempts</bpmn:incoming>
      <bpmn:outgoing>Flow_091_SignAttempts_Resend</bpmn:outgoing>
      <bpmn:outgoing>Flow_092_SignAttempts_OfferCancelled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OfferCancelled" name="Offer cancelled – agreement not signed">
      <bpmn:incoming>Flow_092_SignAttempts_OfferCancelled</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_OfferCancelled_def" messageRef="Msg_OfferNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Income" name="Verify Income &amp; Employment">
      <bpmn:incoming>Flow_023_Split_Income</bpmn:incoming>
      <bpmn:outgoing>Flow_039_Income_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_ManualKYC" name="Verify Identity Manually">
      <bpmn:incoming>Flow_028_Flag_ManualKYC</bpmn:incoming>
      <bpmn:outgoing>Flow_030_ManualKYC_KYCRes</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_KYCRes" name="Identity resolved?">
      <bpmn:incoming>Flow_030_ManualKYC_KYCRes</bpmn:incoming>
      <bpmn:outgoing>Flow_031_KYCRes_KYCRej</bpmn:outgoing>
      <bpmn:outgoing>Flow_032_KYCRes_HumanMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_KYCRej" name="Rejected – identity not verified">
      <bpmn:incoming>Flow_031_KYCRes_KYCRej</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_KYCRej_def" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_ManualCredit" name="Perform Manual Credit Check">
      <bpmn:incoming>Flow_041_BureauErr_ManualCredit</bpmn:incoming>
      <bpmn:outgoing>Flow_042_ManualCredit_BDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_Collateral" name="Value Collateral &amp; Verify Title">
      <bpmn:incoming>Flow_057_Split_Collateral</bpmn:incoming>
      <bpmn:outgoing>Flow_060_Collateral_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_Revalue" name="Revalue Collateral &amp; Reduce Loan Amount">
      <bpmn:incoming>Flow_066_UWDec_Revalue</bpmn:incoming>
      <bpmn:outgoing>Flow_067_Revalue_UWMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="OR_Split" name="Extra checks required?" default="Flow_059_Split_Join">
      <bpmn:incoming>Flow_048_Risk_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_057_Split_Collateral</bpmn:outgoing>
      <bpmn:outgoing>Flow_058_Split_EDD</bpmn:outgoing>
      <bpmn:outgoing>Flow_059_Split_Join</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:inclusiveGateway id="OR_Join">
      <bpmn:incoming>Flow_059_Split_Join</bpmn:incoming>
      <bpmn:incoming>Flow_060_Collateral_Join</bpmn:incoming>
      <bpmn:incoming>Flow_061_EDD_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_062_Join_UWMerge</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:exclusiveGateway id="GW_UWMerge">
      <bpmn:incoming>Flow_062_Join_UWMerge</bpmn:incoming>
      <bpmn:incoming>Flow_067_Revalue_UWMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_063_UWMerge_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Review" name="Review Case &amp; Decide">
      <bpmn:incoming>Flow_063_UWMerge_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_064_Review_UWDec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_WithdrawUW" name="Withdrawal received" attachedToRef="UT_Review">
      <bpmn:outgoing>Flow_081_WithdrawUW_WMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_WithdrawUW_def" messageRef="Msg_Withdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_UWDec" name="Underwriter decision?">
      <bpmn:incoming>Flow_064_Review_UWDec</bpmn:incoming>
      <bpmn:outgoing>Flow_065_UWDec_ApproveMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_066_UWDec_Revalue</bpmn:outgoing>
      <bpmn:outgoing>Flow_068_UWDec_Esc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Esc" name="Above authority or borderline?">
      <bpmn:incoming>Flow_068_UWDec_Esc</bpmn:incoming>
      <bpmn:outgoing>Flow_069_Esc_Committee</bpmn:outgoing>
      <bpmn:outgoing>Flow_070_Esc_RejUW</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejUW" name="Rejected by underwriter – reasons sent">
      <bpmn:incoming>Flow_070_Esc_RejUW</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_RejUW_def" messageRef="Msg_RejectionNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Committee" name="Decide Escalated Case (Senior Credit Committee)">
      <bpmn:incoming>Flow_069_Esc_Committee</bpmn:incoming>
      <bpmn:outgoing>Flow_072_Committee_Committee</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_SLA" name="3-day SLA exceeded" cancelActivity="false" attachedToRef="UT_Committee">
      <bpmn:outgoing>Flow_071_SLA_SLA</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_SLA_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_SLA" name="SLA reminder sent to committee">
      <bpmn:incoming>Flow_071_SLA_SLA</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_SLA_def" messageRef="Msg_SlaReminder" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Committee" name="Committee decision?">
      <bpmn:incoming>Flow_072_Committee_Committee</bpmn:incoming>
      <bpmn:outgoing>Flow_073_Committee_ApproveMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_074_Committee_RejCommittee</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejCommittee" name="Rejected by credit committee – reasons sent">
      <bpmn:incoming>Flow_074_Committee_RejCommittee</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_RejCommittee_def" messageRef="Msg_RejectionNotice" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_ApproveMerge">
      <bpmn:incoming>Flow_065_UWDec_ApproveMerge</bpmn:incoming>
      <bpmn:incoming>Flow_073_Committee_ApproveMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_075_ApproveMerge_OfferMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Flag" name="Flag type?">
      <bpmn:incoming>Flow_027_KYC_Flag</bpmn:incoming>
      <bpmn:outgoing>Flow_028_Flag_ManualKYC</bpmn:outgoing>
      <bpmn:outgoing>Flow_029_Flag_Fraud</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_Fraud" name="Fraud / AML Investigation">
      <bpmn:incoming>Flow_029_Flag_Fraud</bpmn:incoming>
      <bpmn:outgoing>Flow_033_Fraud_Fraud</bpmn:outgoing>
      <bpmn:startEvent id="FR_Start" name="Alert raised">
        <bpmn:outgoing>Flow_001_Start_Review</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="FR_Review" name="Review Alert &amp; Application Documents">
        <bpmn:incoming>Flow_001_Start_Review</bpmn:incoming>
        <bpmn:outgoing>Flow_002_Review_Check</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="FR_Check" name="Check Sanctions Lists &amp; Source Documents">
        <bpmn:incoming>Flow_002_Review_Check</bpmn:incoming>
        <bpmn:outgoing>Flow_003_Check_Record</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="FR_Record" name="Record Investigation Finding">
        <bpmn:incoming>Flow_003_Check_Record</bpmn:incoming>
        <bpmn:outgoing>Flow_004_Record_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="FR_End" name="Alert investigated">
        <bpmn:incoming>Flow_004_Record_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_001_Start_Review" sourceRef="FR_Start" targetRef="FR_Review" />
      <bpmn:sequenceFlow id="Flow_002_Review_Check" sourceRef="FR_Review" targetRef="FR_Check" />
      <bpmn:sequenceFlow id="Flow_003_Check_Record" sourceRef="FR_Check" targetRef="FR_Record" />
      <bpmn:sequenceFlow id="Flow_004_Record_End" sourceRef="FR_Record" targetRef="FR_End" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW_Fraud" name="Fraud / AML confirmed?">
      <bpmn:incoming>Flow_033_Fraud_Fraud</bpmn:incoming>
      <bpmn:outgoing>Flow_034_Fraud_SAR</bpmn:outgoing>
      <bpmn:outgoing>Flow_036_Fraud_HumanMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_SAR" name="File Internal Report">
      <bpmn:incoming>Flow_034_Fraud_SAR</bpmn:incoming>
      <bpmn:outgoing>Flow_035_SAR_Fraud</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Fraud" name="Rejected – fraud / AML confirmed">
      <bpmn:incoming>Flow_035_SAR_Fraud</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Fraud_def" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_EDD" name="Perform Enhanced Due Diligence">
      <bpmn:incoming>Flow_058_Split_EDD</bpmn:incoming>
      <bpmn:outgoing>Flow_061_EDD_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_HumanMerge">
      <bpmn:incoming>Flow_032_KYCRes_HumanMerge</bpmn:incoming>
      <bpmn:incoming>Flow_036_Fraud_HumanMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_037_HumanMerge_KYCDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Expired" name="Offer expired">
      <bpmn:incoming>Flow_079_OfferTimer_Expired</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Expired_def" messageRef="Msg_OfferNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_VerifyAcct" name="Verify Bank Account Details">
      <bpmn:incoming>Flow_098_DisbErr_VerifyAcct</bpmn:incoming>
      <bpmn:outgoing>Flow_099_VerifyAcct_DisbRetry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_DisbRetry" name="Disbursement retries &lt; 2?">
      <bpmn:incoming>Flow_099_VerifyAcct_DisbRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_100_DisbRetry_DisbMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_101_DisbRetry_CompAcct</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ev_CompAcct" name="Reverse loan account">
      <bpmn:incoming>Flow_101_DisbRetry_CompAcct</bpmn:incoming>
      <bpmn:outgoing>Flow_102_CompAcct_HoldFunds</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_CompAcct_def" activityRef="ST_CreateAccount" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="UT_HoldFunds" name="Hold Funds &amp; Contact Applicant">
      <bpmn:incoming>Flow_102_CompAcct_HoldFunds</bpmn:incoming>
      <bpmn:outgoing>Flow_103_HoldFunds_DisbFailed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_DisbFailed" name="Closed – disbursement failed, funds held">
      <bpmn:incoming>Flow_103_HoldFunds_DisbFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_DocMerge">
      <bpmn:incoming>Flow_013_Submit_DocMerge</bpmn:incoming>
      <bpmn:incoming>Flow_019_Missing_DocMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_014_DocMerge_Docs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BRT_Docs" name="Check Document Completeness">
      <bpmn:incoming>Flow_014_DocMerge_Docs</bpmn:incoming>
      <bpmn:outgoing>Flow_015_Docs_Docs</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Docs" name="Documents complete?">
      <bpmn:incoming>Flow_015_Docs_Docs</bpmn:incoming>
      <bpmn:outgoing>Flow_016_Docs_Fee</bpmn:outgoing>
      <bpmn:outgoing>Flow_017_Docs_Missing</bpmn:outgoing>
      <bpmn:outgoing>Flow_018_Docs_RejDocs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejDocs" name="Rejected – documents incomplete">
      <bpmn:incoming>Flow_018_Docs_RejDocs</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_RejDocs_def" messageRef="Msg_RejectionNotice" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_Fee" name="Collect Processing Fee &amp; Place Hold">
      <bpmn:incoming>Flow_016_Docs_Fee</bpmn:incoming>
      <bpmn:outgoing>Flow_021_Fee_Split</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_CompFee" name="Undo fee" attachedToRef="ST_Fee">
      <bpmn:compensateEventDefinition id="B_CompFee_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_ReverseFee" name="Reverse Processing Fee &amp; Release Holds" isForCompensation="true" />
    <bpmn:parallelGateway id="AND_Split">
      <bpmn:incoming>Flow_021_Fee_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_022_Split_KYC</bpmn:outgoing>
      <bpmn:outgoing>Flow_023_Split_Income</bpmn:outgoing>
      <bpmn:outgoing>Flow_024_Split_Bureau</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ST_KYC" name="Run KYC &amp; AML Screening">
      <bpmn:incoming>Flow_022_Split_KYC</bpmn:incoming>
      <bpmn:outgoing>Flow_025_KYC_KYC</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_KYC" name="Screening result?">
      <bpmn:incoming>Flow_025_KYC_KYC</bpmn:incoming>
      <bpmn:outgoing>Flow_026_KYC_KYCDone</bpmn:outgoing>
      <bpmn:outgoing>Flow_027_KYC_Flag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_KYCDone">
      <bpmn:incoming>Flow_026_KYC_KYCDone</bpmn:incoming>
      <bpmn:incoming>Flow_037_HumanMerge_KYCDone</bpmn:incoming>
      <bpmn:outgoing>Flow_038_KYCDone_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_Bureau" name="Retrieve Credit Bureau Report">
      <bpmn:incoming>Flow_024_Split_Bureau</bpmn:incoming>
      <bpmn:outgoing>Flow_040_Bureau_BDone</bpmn:outgoing>
      <bpmn:startEvent id="BU_Start" name="Credit report needed">
        <bpmn:outgoing>Flow_005_Start_Merge</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="BU_Merge">
        <bpmn:incoming>Flow_005_Start_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_010_Wait_Merge</bpmn:incoming>
        <bpmn:outgoing>Flow_006_Merge_Call</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="BU_Call" name="Request Credit Report from Bureau">
        <bpmn:incoming>Flow_006_Merge_Call</bpmn:incoming>
        <bpmn:outgoing>Flow_007_Call_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="BU_B_Err" name="API timeout / bureau down" attachedToRef="BU_Call">
        <bpmn:outgoing>Flow_008_B_Err_GwRetry</bpmn:outgoing>
        <bpmn:errorEventDefinition id="BU_B_Err_def" errorRef="Error_BureauCall" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="BU_End" name="Credit report received">
        <bpmn:incoming>Flow_007_Call_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="BU_GwRetry" name="Retries &lt; 3?">
        <bpmn:incoming>Flow_008_B_Err_GwRetry</bpmn:incoming>
        <bpmn:outgoing>Flow_009_GwRetry_Wait</bpmn:outgoing>
        <bpmn:outgoing>Flow_011_GwRetry_ErrEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="BU_Wait" name="Wait 10 min">
        <bpmn:incoming>Flow_009_GwRetry_Wait</bpmn:incoming>
        <bpmn:outgoing>Flow_010_Wait_Merge</bpmn:outgoing>
        <bpmn:timerEventDefinition id="BU_Wait_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="BU_ErrEnd" name="Bureau unavailable">
        <bpmn:incoming>Flow_011_GwRetry_ErrEnd</bpmn:incoming>
        <bpmn:errorEventDefinition id="BU_ErrEnd_def" errorRef="Error_BureauUnavailable" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_005_Start_Merge" sourceRef="BU_Start" targetRef="BU_Merge" />
      <bpmn:sequenceFlow id="Flow_006_Merge_Call" sourceRef="BU_Merge" targetRef="BU_Call" />
      <bpmn:sequenceFlow id="Flow_007_Call_End" sourceRef="BU_Call" targetRef="BU_End" />
      <bpmn:sequenceFlow id="Flow_008_B_Err_GwRetry" sourceRef="BU_B_Err" targetRef="BU_GwRetry" />
      <bpmn:sequenceFlow id="Flow_009_GwRetry_Wait" name="Yes" sourceRef="BU_GwRetry" targetRef="BU_Wait">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bureauRetries &lt; 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_010_Wait_Merge" sourceRef="BU_Wait" targetRef="BU_Merge" />
      <bpmn:sequenceFlow id="Flow_011_GwRetry_ErrEnd" name="No" sourceRef="BU_GwRetry" targetRef="BU_ErrEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bureauRetries &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_BureauErr" name="Bureau unavailable after 3 retries" attachedToRef="SP_Bureau">
      <bpmn:outgoing>Flow_041_BureauErr_ManualCredit</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_BureauErr_def" errorRef="Error_BureauUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_BDone">
      <bpmn:incoming>Flow_040_Bureau_BDone</bpmn:incoming>
      <bpmn:incoming>Flow_042_ManualCredit_BDone</bpmn:incoming>
      <bpmn:outgoing>Flow_043_BDone_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="AND_Join">
      <bpmn:incoming>Flow_038_KYCDone_Join</bpmn:incoming>
      <bpmn:incoming>Flow_039_Income_Join</bpmn:incoming>
      <bpmn:incoming>Flow_043_BDone_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_044_Join_ScoreMerge</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_ScoreMerge">
      <bpmn:incoming>Flow_044_Join_ScoreMerge</bpmn:incoming>
      <bpmn:incoming>Flow_055_CounterAcc_ScoreMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_045_ScoreMerge_Score</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BRT_Score" name="Score Eligibility &amp; Risk">
      <bpmn:incoming>Flow_045_ScoreMerge_Score</bpmn:incoming>
      <bpmn:outgoing>Flow_046_Score_Risk</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Risk" name="Risk decision?">
      <bpmn:incoming>Flow_046_Score_Risk</bpmn:incoming>
      <bpmn:outgoing>Flow_047_Risk_OfferMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_048_Risk_Split</bpmn:outgoing>
      <bpmn:outgoing>Flow_049_Risk_Counter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Counter" name="Counter-offer possible (first time)?">
      <bpmn:incoming>Flow_049_Risk_Counter</bpmn:incoming>
      <bpmn:outgoing>Flow_050_Counter_Counter</bpmn:outgoing>
      <bpmn:outgoing>Flow_051_Counter_RejCredit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejCredit" name="Rejected – credit criteria not met">
      <bpmn:incoming>Flow_051_Counter_RejCredit</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_RejCredit_def" messageRef="Msg_RejectionNotice" />
    </bpmn:endEvent>
    <bpmn:sendTask id="Send_Counter" name="Send Counter-Offer">
      <bpmn:documentation>Counter-offer options: guarantor, collateral, smaller amount or longer tenure.</bpmn:documentation>
      <bpmn:incoming>Flow_050_Counter_Counter</bpmn:incoming>
      <bpmn:outgoing>Flow_052_Counter_CounterResp</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_OfferMerge">
      <bpmn:incoming>Flow_047_Risk_OfferMerge</bpmn:incoming>
      <bpmn:incoming>Flow_075_ApproveMerge_OfferMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_076_OfferMerge_Offer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_Offer" name="Generate Loan Offer">
      <bpmn:incoming>Flow_076_OfferMerge_Offer</bpmn:incoming>
      <bpmn:outgoing>Flow_077_Offer_Offer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_Offer" name="Send Loan Offer to Applicant">
      <bpmn:incoming>Flow_077_Offer_Offer</bpmn:incoming>
      <bpmn:outgoing>Flow_078_Offer_Accept</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Recv_Accept" name="Receive Offer Acceptance">
      <bpmn:incoming>Flow_078_Offer_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_084_Accept_SignMerge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B_OfferTimer" name="15 days: offer validity over" attachedToRef="Recv_Accept">
      <bpmn:outgoing>Flow_079_OfferTimer_Expired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_OfferTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_WithdrawOffer" name="Withdrawal received" attachedToRef="Recv_Accept">
      <bpmn:outgoing>Flow_080_WithdrawOffer_WMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_WithdrawOffer_def" messageRef="Msg_Withdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_WMerge">
      <bpmn:incoming>Flow_080_WithdrawOffer_WMerge</bpmn:incoming>
      <bpmn:incoming>Flow_081_WithdrawUW_WMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_082_WMerge_CompFee</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ev_CompFee" name="Reverse fees &amp; release holds">
      <bpmn:incoming>Flow_082_WMerge_CompFee</bpmn:incoming>
      <bpmn:outgoing>Flow_083_CompFee_Withdrawn</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_CompFee_def" activityRef="ST_Fee" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Withdrawn – fees reversed">
      <bpmn:incoming>Flow_083_CompFee_Withdrawn</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Withdrawn_def" messageRef="Msg_WithdrawalConfirmation" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_SignMerge">
      <bpmn:incoming>Flow_084_Accept_SignMerge</bpmn:incoming>
      <bpmn:incoming>Flow_093_Resend_SignMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_085_SignMerge_Sign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_Resend" name="Resend Agreement &amp; Reminder">
      <bpmn:incoming>Flow_091_SignAttempts_Resend</bpmn:incoming>
      <bpmn:outgoing>Flow_093_Resend_SignMerge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ST_CreateAccount" name="Create Loan Account">
      <bpmn:incoming>Flow_087_SigValid_CreateAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_094_CreateAccount_DisbMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_CompAcct" name="Undo account" attachedToRef="ST_CreateAccount">
      <bpmn:compensateEventDefinition id="B_CompAcct_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_ReverseAcct" name="Reverse Loan Account Creation" isForCompensation="true" />
    <bpmn:exclusiveGateway id="GW_DisbMerge">
      <bpmn:incoming>Flow_094_CreateAccount_DisbMerge</bpmn:incoming>
      <bpmn:incoming>Flow_100_DisbRetry_DisbMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_095_DisbMerge_Disburse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_Disburse" name="Disburse Funds to Verified Account">
      <bpmn:incoming>Flow_095_DisbMerge_Disburse</bpmn:incoming>
      <bpmn:outgoing>Flow_096_Disburse_Disbursed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_DisbErr" name="Invalid account / payment gateway error" attachedToRef="ST_Disburse">
      <bpmn:outgoing>Flow_098_DisbErr_VerifyAcct</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_DisbErr_def" errorRef="Error_Disbursement" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Send_Disbursed" name="Notify Applicant of Disbursement">
      <bpmn:incoming>Flow_096_Disburse_Disbursed</bpmn:incoming>
      <bpmn:outgoing>Flow_097_Disbursed_Disbursed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Disbursed" name="Loan disbursed">
      <bpmn:incoming>Flow_097_Disbursed_Disbursed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_012_Loan_Submit" sourceRef="Start_Loan" targetRef="UT_Submit" />
    <bpmn:sequenceFlow id="Flow_013_Submit_DocMerge" sourceRef="UT_Submit" targetRef="GW_DocMerge" />
    <bpmn:sequenceFlow id="Flow_014_DocMerge_Docs" sourceRef="GW_DocMerge" targetRef="BRT_Docs" />
    <bpmn:sequenceFlow id="Flow_015_Docs_Docs" sourceRef="BRT_Docs" targetRef="GW_Docs" />
    <bpmn:sequenceFlow id="Flow_016_Docs_Fee" name="Yes" sourceRef="GW_Docs" targetRef="ST_Fee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${docsComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_017_Docs_Missing" name="No – list missing items (rounds &lt; 2)" sourceRef="GW_Docs" targetRef="UT_Missing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!docsComplete &amp;&amp; docRounds &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_018_Docs_RejDocs" name="No – 2 rounds used" sourceRef="GW_Docs" targetRef="End_RejDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!docsComplete &amp;&amp; docRounds &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_019_Missing_DocMerge" sourceRef="UT_Missing" targetRef="GW_DocMerge" />
    <bpmn:sequenceFlow id="Flow_020_MissTimer_LapsedDocs" sourceRef="B_MissTimer" targetRef="End_LapsedDocs" />
    <bpmn:sequenceFlow id="Flow_021_Fee_Split" sourceRef="ST_Fee" targetRef="AND_Split" />
    <bpmn:sequenceFlow id="Flow_022_Split_KYC" sourceRef="AND_Split" targetRef="ST_KYC" />
    <bpmn:sequenceFlow id="Flow_023_Split_Income" sourceRef="AND_Split" targetRef="UT_Income" />
    <bpmn:sequenceFlow id="Flow_024_Split_Bureau" sourceRef="AND_Split" targetRef="SP_Bureau" />
    <bpmn:sequenceFlow id="Flow_025_KYC_KYC" sourceRef="ST_KYC" targetRef="GW_KYC" />
    <bpmn:sequenceFlow id="Flow_026_KYC_KYCDone" name="Clear" sourceRef="GW_KYC" targetRef="GW_KYCDone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${screening == 'clear'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_027_KYC_Flag" name="Flagged" sourceRef="GW_KYC" targetRef="GW_Flag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${screening != 'clear'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_028_Flag_ManualKYC" name="Identity mismatch" sourceRef="GW_Flag" targetRef="UT_ManualKYC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${screening == 'mismatch'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_029_Flag_Fraud" name="Fraud / AML" sourceRef="GW_Flag" targetRef="SP_Fraud">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${screening == 'fraud' || screening == 'aml'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_030_ManualKYC_KYCRes" sourceRef="UT_ManualKYC" targetRef="GW_KYCRes" />
    <bpmn:sequenceFlow id="Flow_031_KYCRes_KYCRej" name="No" sourceRef="GW_KYCRes" targetRef="End_KYCRej">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!identityResolved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_032_KYCRes_HumanMerge" name="Yes" sourceRef="GW_KYCRes" targetRef="GW_HumanMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${identityResolved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_033_Fraud_Fraud" sourceRef="SP_Fraud" targetRef="GW_Fraud" />
    <bpmn:sequenceFlow id="Flow_034_Fraud_SAR" name="Yes" sourceRef="GW_Fraud" targetRef="UT_SAR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fraudConfirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_035_SAR_Fraud" sourceRef="UT_SAR" targetRef="End_Fraud" />
    <bpmn:sequenceFlow id="Flow_036_Fraud_HumanMerge" name="No" sourceRef="GW_Fraud" targetRef="GW_HumanMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!fraudConfirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_037_HumanMerge_KYCDone" sourceRef="GW_HumanMerge" targetRef="GW_KYCDone" />
    <bpmn:sequenceFlow id="Flow_038_KYCDone_Join" sourceRef="GW_KYCDone" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_039_Income_Join" sourceRef="UT_Income" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_040_Bureau_BDone" sourceRef="SP_Bureau" targetRef="GW_BDone" />
    <bpmn:sequenceFlow id="Flow_041_BureauErr_ManualCredit" sourceRef="B_BureauErr" targetRef="UT_ManualCredit" />
    <bpmn:sequenceFlow id="Flow_042_ManualCredit_BDone" sourceRef="UT_ManualCredit" targetRef="GW_BDone" />
    <bpmn:sequenceFlow id="Flow_043_BDone_Join" sourceRef="GW_BDone" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_044_Join_ScoreMerge" sourceRef="AND_Join" targetRef="GW_ScoreMerge" />
    <bpmn:sequenceFlow id="Flow_045_ScoreMerge_Score" sourceRef="GW_ScoreMerge" targetRef="BRT_Score" />
    <bpmn:sequenceFlow id="Flow_046_Score_Risk" sourceRef="BRT_Score" targetRef="GW_Risk" />
    <bpmn:sequenceFlow id="Flow_047_Risk_OfferMerge" name="Auto-approve" sourceRef="GW_Risk" targetRef="GW_OfferMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${risk == 'approve'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_048_Risk_Split" name="Manual review" sourceRef="GW_Risk" targetRef="OR_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${risk == 'review'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_049_Risk_Counter" name="Below cutoff or DTI too high" sourceRef="GW_Risk" targetRef="GW_Counter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${risk == 'decline'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_050_Counter_Counter" name="Yes" sourceRef="GW_Counter" targetRef="Send_Counter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${counterOfferPossible &amp;&amp; counterOffers &lt; 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_051_Counter_RejCredit" name="No" sourceRef="GW_Counter" targetRef="End_RejCredit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!counterOfferPossible || counterOffers &gt;= 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_052_Counter_CounterResp" sourceRef="Send_Counter" targetRef="UT_CounterResp" />
    <bpmn:sequenceFlow id="Flow_053_CounterTimer_LapsedCounter" sourceRef="B_CounterTimer" targetRef="End_LapsedCounter" />
    <bpmn:sequenceFlow id="Flow_054_CounterResp_CounterAcc" sourceRef="UT_CounterResp" targetRef="GW_CounterAcc" />
    <bpmn:sequenceFlow id="Flow_055_CounterAcc_ScoreMerge" name="Yes – re-score" sourceRef="GW_CounterAcc" targetRef="GW_ScoreMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${counterAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_056_CounterAcc_CounterDeclined" name="No" sourceRef="GW_CounterAcc" targetRef="End_CounterDeclined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!counterAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_057_Split_Collateral" name="Secured loan" sourceRef="OR_Split" targetRef="UT_Collateral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${secured}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_058_Split_EDD" name="Amount above EDD threshold" sourceRef="OR_Split" targetRef="UT_EDD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; eddThreshold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_059_Split_Join" name="No extra checks" sourceRef="OR_Split" targetRef="OR_Join" />
    <bpmn:sequenceFlow id="Flow_060_Collateral_Join" sourceRef="UT_Collateral" targetRef="OR_Join" />
    <bpmn:sequenceFlow id="Flow_061_EDD_Join" sourceRef="UT_EDD" targetRef="OR_Join" />
    <bpmn:sequenceFlow id="Flow_062_Join_UWMerge" sourceRef="OR_Join" targetRef="GW_UWMerge" />
    <bpmn:sequenceFlow id="Flow_063_UWMerge_Review" sourceRef="GW_UWMerge" targetRef="UT_Review" />
    <bpmn:sequenceFlow id="Flow_064_Review_UWDec" sourceRef="UT_Review" targetRef="GW_UWDec" />
    <bpmn:sequenceFlow id="Flow_065_UWDec_ApproveMerge" name="Approve" sourceRef="GW_UWDec" targetRef="GW_ApproveMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uwDecision == 'approve'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_066_UWDec_Revalue" name="Valuation shortfall (first time)" sourceRef="GW_UWDec" targetRef="UT_Revalue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uwDecision == 'revalue' &amp;&amp; revaluations &lt; 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_067_Revalue_UWMerge" sourceRef="UT_Revalue" targetRef="GW_UWMerge" />
    <bpmn:sequenceFlow id="Flow_068_UWDec_Esc" name="Reject or refer" sourceRef="GW_UWDec" targetRef="GW_Esc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uwDecision == 'reject' || uwDecision == 'refer' || (uwDecision == 'revalue' &amp;&amp; revaluations &gt;= 1)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_069_Esc_Committee" name="Yes" sourceRef="GW_Esc" targetRef="UT_Committee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aboveAuthority || borderline}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_070_Esc_RejUW" name="No – reject" sourceRef="GW_Esc" targetRef="End_RejUW">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!(aboveAuthority || borderline)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_071_SLA_SLA" sourceRef="B_SLA" targetRef="End_SLA" />
    <bpmn:sequenceFlow id="Flow_072_Committee_Committee" sourceRef="UT_Committee" targetRef="GW_Committee" />
    <bpmn:sequenceFlow id="Flow_073_Committee_ApproveMerge" name="Approve" sourceRef="GW_Committee" targetRef="GW_ApproveMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${committeeDecision == 'approve'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_074_Committee_RejCommittee" name="Reject" sourceRef="GW_Committee" targetRef="End_RejCommittee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${committeeDecision == 'reject'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_075_ApproveMerge_OfferMerge" sourceRef="GW_ApproveMerge" targetRef="GW_OfferMerge" />
    <bpmn:sequenceFlow id="Flow_076_OfferMerge_Offer" sourceRef="GW_OfferMerge" targetRef="ST_Offer" />
    <bpmn:sequenceFlow id="Flow_077_Offer_Offer" sourceRef="ST_Offer" targetRef="Send_Offer" />
    <bpmn:sequenceFlow id="Flow_078_Offer_Accept" sourceRef="Send_Offer" targetRef="Recv_Accept" />
    <bpmn:sequenceFlow id="Flow_079_OfferTimer_Expired" sourceRef="B_OfferTimer" targetRef="End_Expired" />
    <bpmn:sequenceFlow id="Flow_080_WithdrawOffer_WMerge" sourceRef="B_WithdrawOffer" targetRef="GW_WMerge" />
    <bpmn:sequenceFlow id="Flow_081_WithdrawUW_WMerge" sourceRef="B_WithdrawUW" targetRef="GW_WMerge" />
    <bpmn:sequenceFlow id="Flow_082_WMerge_CompFee" sourceRef="GW_WMerge" targetRef="Ev_CompFee" />
    <bpmn:sequenceFlow id="Flow_083_CompFee_Withdrawn" sourceRef="Ev_CompFee" targetRef="End_Withdrawn" />
    <bpmn:sequenceFlow id="Flow_084_Accept_SignMerge" sourceRef="Recv_Accept" targetRef="GW_SignMerge" />
    <bpmn:sequenceFlow id="Flow_085_SignMerge_Sign" sourceRef="GW_SignMerge" targetRef="UT_Sign" />
    <bpmn:sequenceFlow id="Flow_086_Sign_SigValid" sourceRef="UT_Sign" targetRef="GW_SigValid" />
    <bpmn:sequenceFlow id="Flow_087_SigValid_CreateAccount" name="Yes" sourceRef="GW_SigValid" targetRef="ST_CreateAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${signatureValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_088_SigValid_SignFail" name="No – mismatch" sourceRef="GW_SigValid" targetRef="GW_SignFail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!signatureValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_089_SignTimer_SignFail" sourceRef="B_SignTimer" targetRef="GW_SignFail" />
    <bpmn:sequenceFlow id="Flow_090_SignFail_SignAttempts" sourceRef="GW_SignFail" targetRef="GW_SignAttempts" />
    <bpmn:sequenceFlow id="Flow_091_SignAttempts_Resend" name="Yes – resend &amp; remind" sourceRef="GW_SignAttempts" targetRef="Send_Resend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${signAttempts &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_092_SignAttempts_OfferCancelled" name="No" sourceRef="GW_SignAttempts" targetRef="End_OfferCancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${signAttempts &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_093_Resend_SignMerge" sourceRef="Send_Resend" targetRef="GW_SignMerge" />
    <bpmn:sequenceFlow id="Flow_094_CreateAccount_DisbMerge" sourceRef="ST_CreateAccount" targetRef="GW_DisbMerge" />
    <bpmn:sequenceFlow id="Flow_095_DisbMerge_Disburse" sourceRef="GW_DisbMerge" targetRef="ST_Disburse" />
    <bpmn:sequenceFlow id="Flow_096_Disburse_Disbursed" sourceRef="ST_Disburse" targetRef="Send_Disbursed" />
    <bpmn:sequenceFlow id="Flow_097_Disbursed_Disbursed" sourceRef="Send_Disbursed" targetRef="End_Disbursed" />
    <bpmn:sequenceFlow id="Flow_098_DisbErr_VerifyAcct" sourceRef="B_DisbErr" targetRef="UT_VerifyAcct" />
    <bpmn:sequenceFlow id="Flow_099_VerifyAcct_DisbRetry" sourceRef="UT_VerifyAcct" targetRef="GW_DisbRetry" />
    <bpmn:sequenceFlow id="Flow_100_DisbRetry_DisbMerge" name="Yes – retry" sourceRef="GW_DisbRetry" targetRef="GW_DisbMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disbursementRetries &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_101_DisbRetry_CompAcct" name="No" sourceRef="GW_DisbRetry" targetRef="Ev_CompAcct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disbursementRetries &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_102_CompAcct_HoldFunds" sourceRef="Ev_CompAcct" targetRef="UT_HoldFunds" />
    <bpmn:sequenceFlow id="Flow_103_HoldFunds_DisbFailed" sourceRef="UT_HoldFunds" targetRef="End_DisbFailed" />
    <bpmn:association id="Association_B_CompFee_ST_ReverseFee" associationDirection="One" sourceRef="B_CompFee" targetRef="ST_ReverseFee" />
    <bpmn:association id="Association_B_CompAcct_ST_ReverseAcct" associationDirection="One" sourceRef="B_CompAcct" targetRef="ST_ReverseAcct" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main" name="Loan Origination &amp; Approval">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Collaboration_Loan">
