<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Shipment" targetNamespace="http://example.edu/bpmn/shipment-exception-management" exporter="hand-authored BPMN 2.0 (bpmn.io compatible)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Shipment">
    <bpmn:participant id="Participant_Courier" name="Courier Company – Shipment Life Cycle" processRef="Process_Shipment" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_Arrival" name="Arrival scan at destination hub" />
  <bpmn:message id="Msg_Delay" name="Delay report" />
  <bpmn:message id="Msg_Cancellation" name="Cancellation request" />
  <bpmn:message id="Msg_AddressQuery" name="Address query" />
  <bpmn:message id="Msg_Surcharge" name="Surcharge advice" />
  <bpmn:message id="Msg_CancelNotice" name="Cancellation notice" />
  <bpmn:message id="Msg_LostNotice" name="Loss and compensation notice" />
  <bpmn:message id="Msg_DamageNotice" name="Damage notice" />
  <bpmn:error id="Error_Scan" name="Scan / tracking system failure" errorCode="SCAN_SYSTEM_FAILURE" />
  <bpmn:process id="Process_Shipment" name="Logistics &amp; Shipment Exception Management" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Shipper" name="Shipper / Customer">
        <bpmn:flowNodeRef>Start_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BookMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Book</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ControlTower" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>BRT_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BookValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_CompCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PickupMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PickAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PickupFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TrackErr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TrackMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Picked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Recall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Reroute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Customs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Cleared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_DocReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recv_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_DocTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_OFD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PickupAgent" name="Pickup Agent">
        <bpmn:flowNodeRef>UT_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Picked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CustDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_OFDMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>MT_Sort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ManualScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MT_Dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AwaitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_DestScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Intact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MT_Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_HoldTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CloseMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RTSMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_RTS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DamageMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Uninsured</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DeliveryAgent" name="Delivery Agent">
        <bpmn:flowNodeRef>UT_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Why</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DelAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_LoopMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RTSPre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recipient" name="Recipient">
        <bpmn:flowNodeRef>Ev_AddrQuery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_NewAddr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_AddrTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Surcharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Surcharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AddrMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>Ev_NoScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TraceTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Claim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Booking" name="Shipper wants to send a parcel">
      <bpmn:outgoing>Flow_016_Booking_BookMerge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_BookMerge">
      <bpmn:incoming>Flow_016_Booking_BookMerge</bpmn:incoming>
      <bpmn:incoming>Flow_021_BookValid_BookMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_017_BookMerge_Book</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Book" name="Create Shipment Booking">
      <bpmn:documentation>Shipper enters addresses, weight, service level and COD amount. Each completion increments bookingAttempts.</bpmn:documentation>
      <bpmn:incoming>Flow_017_BookMerge_Book</bpmn:incoming>
      <bpmn:outgoing>Flow_018_Book_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="BRT_Validate" name="Validate Booking &amp; Calculate Charges">
      <bpmn:documentation>Rule set: address completeness and serviceability, weight limits, service level; returns validity and the charge.</bpmn:documentation>
      <bpmn:incoming>Flow_018_Book_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_019_Validate_BookValid</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_BookValid" name="Booking valid?">
      <bpmn:incoming>Flow_019_Validate_BookValid</bpmn:incoming>
      <bpmn:outgoing>Flow_020_BookValid_Charge</bpmn:outgoing>
      <bpmn:outgoing>Flow_021_BookValid_BookMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_022_BookValid_InvalidBooking</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_InvalidBooking" name="Cancelled – invalid booking">
      <bpmn:incoming>Flow_022_BookValid_InvalidBooking</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_InvalidBooking_def" messageRef="Msg_CancelNotice" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_Charge" name="Confirm Booking &amp; Collect Charges">
      <bpmn:incoming>Flow_020_BookValid_Charge</bpmn:incoming>
      <bpmn:outgoing>Flow_023_Charge_PickupMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_CompCharge" name="Undo charges" attachedToRef="ST_Charge">
      <bpmn:compensateEventDefinition id="B_CompCharge_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_Refund" name="Refund Charges less Cancellation Fee" isForCompensation="true" />
    <bpmn:exclusiveGateway id="GW_PickupMerge">
      <bpmn:incoming>Flow_023_Charge_PickupMerge</bpmn:incoming>
      <bpmn:incoming>Flow_029_PickAttempts_PickupMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_024_PickupMerge_Schedule</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_Schedule" name="Schedule Pickup &amp; Assign Driver">
      <bpmn:incoming>Flow_024_PickupMerge_Schedule</bpmn:incoming>
      <bpmn:outgoing>Flow_025_Schedule_Pickup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_PickAttempts" name="Pickup attempts &lt; 2?">
      <bpmn:incoming>Flow_028_Picked_PickAttempts</bpmn:incoming>
      <bpmn:outgoing>Flow_029_PickAttempts_PickupMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_030_PickAttempts_CompPickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ev_CompPickup" name="Refund less cancellation fee">
      <bpmn:incoming>Flow_030_PickAttempts_CompPickup</bpmn:incoming>
      <bpmn:outgoing>Flow_031_CompPickup_PickupFailed</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_CompPickup_def" activityRef="ST_Charge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_PickupFailed" name="Cancelled – pickup failed">
      <bpmn:incoming>Flow_031_CompPickup_PickupFailed</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_PickupFailed_def" messageRef="Msg_CancelNotice" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_Track" name="Register Scan &amp; Update Tracking">
      <bpmn:incoming>Flow_032_Split_Track</bpmn:incoming>
      <bpmn:outgoing>Flow_034_Track_TrackMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_TrackErr" name="Scan / tracking system failure" attachedToRef="ST_Track">
      <bpmn:outgoing>Flow_035_TrackErr_ManualScan</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_TrackErr_def" errorRef="Error_Scan" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_TrackMerge">
      <bpmn:incoming>Flow_034_Track_TrackMerge</bpmn:incoming>
      <bpmn:incoming>Flow_037_Reconcile_TrackMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_038_TrackMerge_Picked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_Picked" name="Notify Shipper: Parcel Picked Up">
      <bpmn:incoming>Flow_038_TrackMerge_Picked</bpmn:incoming>
      <bpmn:outgoing>Flow_039_Picked_Join</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Ev_Cancel" name="Cancellation requested">
      <bpmn:incoming>Flow_046_Await_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_051_Cancel_Recall</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_Cancel_def" messageRef="Msg_Cancellation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UT_Recall" name="Stop Movement &amp; Return Parcel to Shipper">
      <bpmn:incoming>Flow_051_Cancel_Recall</bpmn:incoming>
      <bpmn:outgoing>Flow_052_Recall_CompCancel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Ev_CompCancel" name="Refund less cancellation fee">
      <bpmn:incoming>Flow_052_Recall_CompCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_053_CompCancel_Cancelled</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_CompCancel_def" activityRef="ST_Charge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Cancelled" name="Cancelled after dispatch – parcel returned">
      <bpmn:incoming>Flow_053_CompCancel_Cancelled</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Cancelled_def" messageRef="Msg_CancelNotice" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Ev_Delay" name="Delay reported">
      <bpmn:incoming>Flow_045_Await_Delay</bpmn:incoming>
      <bpmn:outgoing>Flow_048_Delay_Delay</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_Delay_def" messageRef="Msg_Delay" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Send_Delay" name="Notify Customer of Delay">
      <bpmn:incoming>Flow_048_Delay_Delay</bpmn:incoming>
      <bpmn:outgoing>Flow_049_Delay_Reroute</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UT_Reroute" name="Reroute or Assign Vehicle &amp; Update ETA">
      <bpmn:incoming>Flow_049_Delay_Reroute</bpmn:incoming>
      <bpmn:outgoing>Flow_050_Reroute_AwaitMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_Customs" name="Submit Customs Declaration">
      <bpmn:incoming>Flow_063_Intl_Customs</bpmn:incoming>
      <bpmn:outgoing>Flow_064_Customs_Cleared</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Cleared" name="Customs cleared?">
      <bpmn:incoming>Flow_064_Customs_Cleared</bpmn:incoming>
      <bpmn:outgoing>Flow_065_Cleared_CustDone</bpmn:outgoing>
      <bpmn:outgoing>Flow_066_Cleared_DocReq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_DocReq" name="Request Customs Documents from Shipper">
      <bpmn:incoming>Flow_066_Cleared_DocReq</bpmn:incoming>
      <bpmn:outgoing>Flow_067_DocReq_Docs</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Recv_Docs" name="Receive Customs Documents">
      <bpmn:incoming>Flow_067_DocReq_Docs</bpmn:incoming>
      <bpmn:outgoing>Flow_068_Docs_CustDone</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="B_DocTimer" name="5 days: documents not provided" attachedToRef="Recv_Docs">
      <bpmn:outgoing>Flow_069_DocTimer_RTSMerge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_DocTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Send_OFD" name="Notify Recipient: Out for Delivery">
      <bpmn:incoming>Flow_071_OFDMerge_OFD</bpmn:incoming>
      <bpmn:outgoing>Flow_072_OFD_Deliver</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ST_Close" name="Close Shipment &amp; Generate Invoice">
      <bpmn:incoming>Flow_093_CloseMerge_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_094_Close_Delivered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Delivered" name="Shipment delivered &amp; closed">
      <bpmn:incoming>Flow_094_Close_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Pickup" name="Collect &amp; Scan Parcel">
      <bpmn:incoming>Flow_025_Schedule_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_026_Pickup_Picked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Picked" name="Parcel collected?">
      <bpmn:incoming>Flow_026_Pickup_Picked</bpmn:incoming>
      <bpmn:outgoing>Flow_027_Picked_Split</bpmn:outgoing>
      <bpmn:outgoing>Flow_028_Picked_PickAttempts</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="AND_Split">
      <bpmn:incoming>Flow_027_Picked_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_032_Split_Track</bpmn:outgoing>
      <bpmn:outgoing>Flow_033_Split_Sort</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="AND_Join">
      <bpmn:incoming>Flow_039_Picked_Join</bpmn:incoming>
      <bpmn:incoming>Flow_040_Sort_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_041_Join_Dispatch</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_CustDone">
      <bpmn:incoming>Flow_062_Intl_CustDone</bpmn:incoming>
      <bpmn:incoming>Flow_065_Cleared_CustDone</bpmn:incoming>
      <bpmn:incoming>Flow_068_Docs_CustDone</bpmn:incoming>
      <bpmn:outgoing>Flow_070_CustDone_OFDMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_OFDMerge">
      <bpmn:incoming>Flow_070_CustDone_OFDMerge</bpmn:incoming>
      <bpmn:incoming>Flow_082_LoopMerge_OFDMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_071_OFDMerge_OFD</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="MT_Sort" name="Receive &amp; Sort at Origin Hub">
      <bpmn:incoming>Flow_033_Split_Sort</bpmn:incoming>
      <bpmn:outgoing>Flow_040_Sort_Join</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="UT_ManualScan" name="Update Scan Record Manually">
      <bpmn:incoming>Flow_035_TrackErr_ManualScan</bpmn:incoming>
      <bpmn:outgoing>Flow_036_ManualScan_Reconcile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_Reconcile" name="Reconcile Tracking Records">
      <bpmn:incoming>Flow_036_ManualScan_Reconcile</bpmn:incoming>
      <bpmn:outgoing>Flow_037_Reconcile_TrackMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="MT_Dispatch" name="Dispatch Line-Haul to Destination Hub">
      <bpmn:incoming>Flow_041_Join_Dispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_042_Dispatch_AwaitMerge</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_AwaitMerge">
      <bpmn:incoming>Flow_042_Dispatch_AwaitMerge</bpmn:incoming>
      <bpmn:incoming>Flow_050_Reroute_AwaitMerge</bpmn:incoming>
      <bpmn:incoming>Flow_055_Trace_AwaitMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_043_AwaitMerge_Await</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="GW_Await" name="Await line-haul event">
      <bpmn:incoming>Flow_043_AwaitMerge_Await</bpmn:incoming>
      <bpmn:outgoing>Flow_044_Await_Arrived</bpmn:outgoing>
      <bpmn:outgoing>Flow_045_Await_Delay</bpmn:outgoing>
      <bpmn:outgoing>Flow_046_Await_Cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_047_Await_NoScan</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Ev_Arrived" name="Arrival scan at destination hub">
      <bpmn:incoming>Flow_044_Await_Arrived</bpmn:incoming>
      <bpmn:outgoing>Flow_058_Arrived_DestScan</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_Arrived_def" messageRef="Msg_Arrival" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UT_DestScan" name="Scan &amp; Inspect at Destination Hub">
      <bpmn:incoming>Flow_058_Arrived_DestScan</bpmn:incoming>
      <bpmn:outgoing>Flow_059_DestScan_Intact</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Intact" name="Parcel intact?">
      <bpmn:incoming>Flow_059_DestScan_Intact</bpmn:incoming>
      <bpmn:outgoing>Flow_060_Intact_Intl</bpmn:outgoing>
      <bpmn:outgoing>Flow_061_Intact_DamageMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Intl" name="International shipment?">
      <bpmn:incoming>Flow_060_Intact_Intl</bpmn:incoming>
      <bpmn:outgoing>Flow_062_Intl_CustDone</bpmn:outgoing>
      <bpmn:outgoing>Flow_063_Intl_Customs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="MT_Hold" name="Hold Parcel at Depot for Collection">
      <bpmn:incoming>Flow_081_DelAttempts_Hold</bpmn:incoming>
      <bpmn:outgoing>Flow_083_Hold_CloseMerge</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:boundaryEvent id="B_HoldTimer" name="7 days: not collected" attachedToRef="MT_Hold">
      <bpmn:outgoing>Flow_084_HoldTimer_RTSMerge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_HoldTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_CloseMerge">
      <bpmn:incoming>Flow_074_Outcome_CloseMerge</bpmn:incoming>
      <bpmn:incoming>Flow_083_Hold_CloseMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_093_CloseMerge_Close</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_RTSMerge">
      <bpmn:incoming>Flow_069_DocTimer_RTSMerge</bpmn:incoming>
      <bpmn:incoming>Flow_084_HoldTimer_RTSMerge</bpmn:incoming>
      <bpmn:incoming>Flow_092_RTSPre_RTSMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_100_RTSMerge_RTS</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_RTS" name="Return Parcel to Sender">
      <bpmn:incoming>Flow_100_RTSMerge_RTS</bpmn:incoming>
      <bpmn:outgoing>Flow_101_RTS_Returned</bpmn:outgoing>
      <bpmn:startEvent id="RT_Start" name="Return initiated">
        <bpmn:outgoing>Flow_011_Start_Haul</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="RT_Haul" name="Line-Haul Parcel Back to Origin Hub">
        <bpmn:incoming>Flow_011_Start_Haul</bpmn:incoming>
        <bpmn:outgoing>Flow_012_Haul_Charges</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:serviceTask id="RT_Charges" name="Adjust Charges (return fee / COD reversal)">
        <bpmn:incoming>Flow_012_Haul_Charges</bpmn:incoming>
        <bpmn:outgoing>Flow_013_Charges_Notify</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="RT_Notify" name="Notify Shipper of Return">
        <bpmn:incoming>Flow_013_Charges_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_014_Notify_Handover</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:manualTask id="RT_Handover" name="Hand Over Parcel to Shipper">
        <bpmn:incoming>Flow_014_Notify_Handover</bpmn:incoming>
        <bpmn:outgoing>Flow_015_Handover_End</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:endEvent id="RT_End" name="Parcel returned">
        <bpmn:incoming>Flow_015_Handover_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_011_Start_Haul" sourceRef="RT_Start" targetRef="RT_Haul" />
      <bpmn:sequenceFlow id="Flow_012_Haul_Charges" sourceRef="RT_Haul" targetRef="RT_Charges" />
      <bpmn:sequenceFlow id="Flow_013_Charges_Notify" sourceRef="RT_Charges" targetRef="RT_Notify" />
      <bpmn:sequenceFlow id="Flow_014_Notify_Handover" sourceRef="RT_Notify" targetRef="RT_Handover" />
      <bpmn:sequenceFlow id="Flow_015_Handover_End" sourceRef="RT_Handover" targetRef="RT_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Returned" name="Returned to sender">
      <bpmn:incoming>Flow_101_RTS_Returned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_DamageMerge">
      <bpmn:incoming>Flow_061_Intact_DamageMerge</bpmn:incoming>
      <bpmn:incoming>Flow_075_Outcome_DamageMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_095_DamageMerge_Inspect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Inspect" name="Inspect &amp; Document Damage">
      <bpmn:incoming>Flow_095_DamageMerge_Inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_096_Inspect_Insured</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Insured" name="Shipment insured?">
      <bpmn:incoming>Flow_096_Inspect_Insured</bpmn:incoming>
      <bpmn:outgoing>Flow_097_Insured_Uninsured</bpmn:outgoing>
      <bpmn:outgoing>Flow_098_Insured_Claim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Uninsured" name="Closed – damage recorded, shipper informed">
      <bpmn:incoming>Flow_097_Insured_Uninsured</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Uninsured_def" messageRef="Msg_DamageNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Deliver" name="Attempt Delivery &amp; Capture Proof of Delivery">
      <bpmn:incoming>Flow_072_OFD_Deliver</bpmn:incoming>
      <bpmn:outgoing>Flow_073_Deliver_Outcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Outcome" name="Delivery outcome?">
      <bpmn:incoming>Flow_073_Deliver_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_074_Outcome_CloseMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_075_Outcome_DamageMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_076_Outcome_Why</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Why" name="Reason?">
      <bpmn:incoming>Flow_076_Outcome_Why</bpmn:incoming>
      <bpmn:outgoing>Flow_077_Why_DelAttempts</bpmn:outgoing>
      <bpmn:outgoing>Flow_078_Why_AddrQuery</bpmn:outgoing>
      <bpmn:outgoing>Flow_079_Why_RTSPre</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_DelAttempts" name="Delivery attempts &lt; 3?">
      <bpmn:incoming>Flow_077_Why_DelAttempts</bpmn:incoming>
      <bpmn:outgoing>Flow_080_DelAttempts_LoopMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_081_DelAttempts_Hold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_LoopMerge">
      <bpmn:incoming>Flow_080_DelAttempts_LoopMerge</bpmn:incoming>
      <bpmn:incoming>Flow_090_AddrMerge_LoopMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_082_LoopMerge_OFDMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_RTSPre">
      <bpmn:incoming>Flow_079_Why_RTSPre</bpmn:incoming>
      <bpmn:incoming>Flow_091_AddrTimer_RTSPre</bpmn:incoming>
      <bpmn:outgoing>Flow_092_RTSPre_RTSMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ev_AddrQuery" name="Address query sent to recipient">
      <bpmn:incoming>Flow_078_Why_AddrQuery</bpmn:incoming>
      <bpmn:outgoing>Flow_085_AddrQuery_NewAddr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_AddrQuery_def" messageRef="Msg_AddressQuery" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="UT_NewAddr" name="Provide Corrected Address">
      <bpmn:incoming>Flow_085_AddrQuery_NewAddr</bpmn:incoming>
      <bpmn:outgoing>Flow_086_NewAddr_Surcharge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_AddrTimer" name="2 days: no reply" attachedToRef="UT_NewAddr">
      <bpmn:outgoing>Flow_091_AddrTimer_RTSPre</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_AddrTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_Surcharge" name="Outside original delivery zone?">
      <bpmn:incoming>Flow_086_NewAddr_Surcharge</bpmn:incoming>
      <bpmn:outgoing>Flow_087_Surcharge_Surcharge</bpmn:outgoing>
      <bpmn:outgoing>Flow_088_Surcharge_AddrMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ev_Surcharge" name="Address-change surcharge advised">
      <bpmn:incoming>Flow_087_Surcharge_Surcharge</bpmn:incoming>
      <bpmn:outgoing>Flow_089_Surcharge_AddrMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_Surcharge_def" messageRef="Msg_Surcharge" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="GW_AddrMerge">
      <bpmn:incoming>Flow_088_Surcharge_AddrMerge</bpmn:incoming>
      <bpmn:incoming>Flow_089_Surcharge_AddrMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_090_AddrMerge_LoopMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Ev_NoScan" name="No scan event for 48 h">
      <bpmn:incoming>Flow_047_Await_NoScan</bpmn:incoming>
      <bpmn:outgoing>Flow_054_NoScan_Trace</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ev_NoScan_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UT_Trace" name="Trace Missing Parcel">
      <bpmn:incoming>Flow_054_NoScan_Trace</bpmn:incoming>
      <bpmn:outgoing>Flow_055_Trace_AwaitMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_TraceTimer" name="5 days: not found" attachedToRef="UT_Trace">
      <bpmn:outgoing>Flow_056_TraceTimer_Lost</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_TraceTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_Lost" name="Declare Lost &amp; Pay Compensation">
      <bpmn:incoming>Flow_056_TraceTimer_Lost</bpmn:incoming>
      <bpmn:outgoing>Flow_057_Lost_Lost</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Lost" name="Lost – shipper compensated">
      <bpmn:incoming>Flow_057_Lost_Lost</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Lost_def" messageRef="Msg_LostNotice" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Claim" name="Handle Damage Claim">
      <bpmn:incoming>Flow_098_Insured_Claim</bpmn:incoming>
      <bpmn:outgoing>Flow_099_Claim_Claim</bpmn:outgoing>
      <bpmn:startEvent id="CL_Start" name="Claim opened">
        <bpmn:outgoing>Flow_001_Start_Assess</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="CL_Assess" name="Assess Claim &amp; Evidence">
        <bpmn:incoming>Flow_001_Start_Assess</bpmn:incoming>
        <bpmn:outgoing>Flow_002_Assess_GwRes</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="CL_GwRes" name="Resolution?">
        <bpmn:incoming>Flow_002_Assess_GwRes</bpmn:incoming>
        <bpmn:outgoing>Flow_003_GwRes_Refund</bpmn:outgoing>
        <bpmn:outgoing>Flow_004_GwRes_Replace</bpmn:outgoing>
        <bpmn:outgoing>Flow_005_GwRes_Reship</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CL_Refund" name="Issue Refund">
        <bpmn:incoming>Flow_003_GwRes_Refund</bpmn:incoming>
        <bpmn:outgoing>Flow_006_Refund_Merge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="CL_Replace" name="Arrange Replacement">
        <bpmn:incoming>Flow_004_GwRes_Replace</bpmn:incoming>
        <bpmn:outgoing>Flow_007_Replace_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="CL_Reship" name="Arrange Reshipment">
        <bpmn:incoming>Flow_005_GwRes_Reship</bpmn:incoming>
        <bpmn:outgoing>Flow_008_Reship_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="CL_Merge">
        <bpmn:incoming>Flow_006_Refund_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_007_Replace_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_008_Reship_Merge</bpmn:incoming>
        <bpmn:outgoing>Flow_009_Merge_Notify</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="CL_Notify" name="Notify Shipper of Claim Outcome">
        <bpmn:incoming>Flow_009_Merge_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_010_Notify_End</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="CL_End" name="Claim settled">
        <bpmn:incoming>Flow_010_Notify_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_001_Start_Assess" sourceRef="CL_Start" targetRef="CL_Assess" />
      <bpmn:sequenceFlow id="Flow_002_Assess_GwRes" sourceRef="CL_Assess" targetRef="CL_GwRes" />
      <bpmn:sequenceFlow id="Flow_003_GwRes_Refund" name="Refund" sourceRef="CL_GwRes" targetRef="CL_Refund">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resolution == 'refund'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_004_GwRes_Replace" name="Replacement" sourceRef="CL_GwRes" targetRef="CL_Replace">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resolution == 'replacement'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_005_GwRes_Reship" name="Reshipment" sourceRef="CL_GwRes" targetRef="CL_Reship">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resolution == 'reshipment'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_006_Refund_Merge" sourceRef="CL_Refund" targetRef="CL_Merge" />
      <bpmn:sequenceFlow id="Flow_007_Replace_Merge" sourceRef="CL_Replace" targetRef="CL_Merge" />
      <bpmn:sequenceFlow id="Flow_008_Reship_Merge" sourceRef="CL_Reship" targetRef="CL_Merge" />
      <bpmn:sequenceFlow id="Flow_009_Merge_Notify" sourceRef="CL_Merge" targetRef="CL_Notify" />
      <bpmn:sequenceFlow id="Flow_010_Notify_End" sourceRef="CL_Notify" targetRef="CL_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Claim" name="Closed – damage claim settled">
      <bpmn:incoming>Flow_099_Claim_Claim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_016_Booking_BookMerge" sourceRef="Start_Booking" targetRef="GW_BookMerge" />
    <bpmn:sequenceFlow id="Flow_017_BookMerge_Book" sourceRef="GW_BookMerge" targetRef="UT_Book" />
    <bpmn:sequenceFlow id="Flow_018_Book_Validate" sourceRef="UT_Book" targetRef="BRT_Validate" />
    <bpmn:sequenceFlow id="Flow_019_Validate_BookValid" sourceRef="BRT_Validate" targetRef="GW_BookValid" />
    <bpmn:sequenceFlow id="Flow_020_BookValid_Charge" name="Yes" sourceRef="GW_BookValid" targetRef="ST_Charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bookingValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_021_BookValid_BookMerge" name="No – return to shipper (attempts &lt; 3)" sourceRef="GW_BookValid" targetRef="GW_BookMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!bookingValid &amp;&amp; bookingAttempts &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_022_BookValid_InvalidBooking" name="No – 3 attempts used" sourceRef="GW_BookValid" targetRef="End_InvalidBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!bookingValid &amp;&amp; bookingAttempts &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_023_Charge_PickupMerge" sourceRef="ST_Charge" targetRef="GW_PickupMerge" />
    <bpmn:sequenceFlow id="Flow_024_PickupMerge_Schedule" sourceRef="GW_PickupMerge" targetRef="ST_Schedule" />
    <bpmn:sequenceFlow id="Flow_025_Schedule_Pickup" sourceRef="ST_Schedule" targetRef="UT_Pickup" />
    <bpmn:sequenceFlow id="Flow_026_Pickup_Picked" sourceRef="UT_Pickup" targetRef="GW_Picked" />
    <bpmn:sequenceFlow id="Flow_027_Picked_Split" name="Yes" sourceRef="GW_Picked" targetRef="AND_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parcelCollected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_028_Picked_PickAttempts" name="No – shipper absent / parcel not ready" sourceRef="GW_Picked" targetRef="GW_PickAttempts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!parcelCollected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_029_PickAttempts_PickupMerge" name="Yes – reschedule" sourceRef="GW_PickAttempts" targetRef="GW_PickupMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pickupAttempts &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_030_PickAttempts_CompPickup" name="No" sourceRef="GW_PickAttempts" targetRef="Ev_CompPickup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pickupAttempts &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_031_CompPickup_PickupFailed" sourceRef="Ev_CompPickup" targetRef="End_PickupFailed" />
    <bpmn:sequenceFlow id="Flow_032_Split_Track" sourceRef="AND_Split" targetRef="ST_Track" />
    <bpmn:sequenceFlow id="Flow_033_Split_Sort" sourceRef="AND_Split" targetRef="MT_Sort" />
    <bpmn:sequenceFlow id="Flow_034_Track_TrackMerge" sourceRef="ST_Track" targetRef="GW_TrackMerge" />
    <bpmn:sequenceFlow id="Flow_035_TrackErr_ManualScan" sourceRef="B_TrackErr" targetRef="UT_ManualScan" />
    <bpmn:sequenceFlow id="Flow_036_ManualScan_Reconcile" sourceRef="UT_ManualScan" targetRef="ST_Reconcile" />
    <bpmn:sequenceFlow id="Flow_037_Reconcile_TrackMerge" sourceRef="ST_Reconcile" targetRef="GW_TrackMerge" />
    <bpmn:sequenceFlow id="Flow_038_TrackMerge_Picked" sourceRef="GW_TrackMerge" targetRef="Send_Picked" />
    <bpmn:sequenceFlow id="Flow_039_Picked_Join" sourceRef="Send_Picked" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_040_Sort_Join" sourceRef="MT_Sort" targetRef="AND_Join" />
    <bpmn:sequenceFlow id="Flow_041_Join_Dispatch" sourceRef="AND_Join" targetRef="MT_Dispatch" />
    <bpmn:sequenceFlow id="Flow_042_Dispatch_AwaitMerge" sourceRef="MT_Dispatch" targetRef="GW_AwaitMerge" />
    <bpmn:sequenceFlow id="Flow_043_AwaitMerge_Await" sourceRef="GW_AwaitMerge" targetRef="GW_Await" />
    <bpmn:sequenceFlow id="Flow_044_Await_Arrived" sourceRef="GW_Await" targetRef="Ev_Arrived" />
    <bpmn:sequenceFlow id="Flow_045_Await_Delay" sourceRef="GW_Await" targetRef="Ev_Delay" />
    <bpmn:sequenceFlow id="Flow_046_Await_Cancel" sourceRef="GW_Await" targetRef="Ev_Cancel" />
    <bpmn:sequenceFlow id="Flow_047_Await_NoScan" sourceRef="GW_Await" targetRef="Ev_NoScan" />
    <bpmn:sequenceFlow id="Flow_048_Delay_Delay" sourceRef="Ev_Delay" targetRef="Send_Delay" />
    <bpmn:sequenceFlow id="Flow_049_Delay_Reroute" sourceRef="Send_Delay" targetRef="UT_Reroute" />
    <bpmn:sequenceFlow id="Flow_050_Reroute_AwaitMerge" sourceRef="UT_Reroute" targetRef="GW_AwaitMerge" />
    <bpmn:sequenceFlow id="Flow_051_Cancel_Recall" sourceRef="Ev_Cancel" targetRef="UT_Recall" />
    <bpmn:sequenceFlow id="Flow_052_Recall_CompCancel" sourceRef="UT_Recall" targetRef="Ev_CompCancel" />
    <bpmn:sequenceFlow id="Flow_053_CompCancel_Cancelled" sourceRef="Ev_CompCancel" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="Flow_054_NoScan_Trace" sourceRef="Ev_NoScan" targetRef="UT_Trace" />
    <bpmn:sequenceFlow id="Flow_055_Trace_AwaitMerge" sourceRef="UT_Trace" targetRef="GW_AwaitMerge" />
    <bpmn:sequenceFlow id="Flow_056_TraceTimer_Lost" sourceRef="B_TraceTimer" targetRef="ST_Lost" />
    <bpmn:sequenceFlow id="Flow_057_Lost_Lost" sourceRef="ST_Lost" targetRef="End_Lost" />
    <bpmn:sequenceFlow id="Flow_058_Arrived_DestScan" sourceRef="Ev_Arrived" targetRef="UT_DestScan" />
    <bpmn:sequenceFlow id="Flow_059_DestScan_Intact" sourceRef="UT_DestScan" targetRef="GW_Intact" />
    <bpmn:sequenceFlow id="Flow_060_Intact_Intl" name="Yes" sourceRef="GW_Intact" targetRef="GW_Intl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parcelIntact}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_061_Intact_DamageMerge" name="No – damage found" sourceRef="GW_Intact" targetRef="GW_DamageMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!parcelIntact}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_062_Intl_CustDone" name="No" sourceRef="GW_Intl" targetRef="GW_CustDone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!international}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_063_Intl_Customs" name="Yes" sourceRef="GW_Intl" targetRef="UT_Customs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${international}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_064_Customs_Cleared" sourceRef="UT_Customs" targetRef="GW_Cleared" />
    <bpmn:sequenceFlow id="Flow_065_Cleared_CustDone" name="Yes" sourceRef="GW_Cleared" targetRef="GW_CustDone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customsCleared}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_066_Cleared_DocReq" name="No – held" sourceRef="GW_Cleared" targetRef="Send_DocReq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!customsCleared}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_067_DocReq_Docs" sourceRef="Send_DocReq" targetRef="Recv_Docs" />
    <bpmn:sequenceFlow id="Flow_068_Docs_CustDone" sourceRef="Recv_Docs" targetRef="GW_CustDone" />
    <bpmn:sequenceFlow id="Flow_069_DocTimer_RTSMerge" sourceRef="B_DocTimer" targetRef="GW_RTSMerge" />
    <bpmn:sequenceFlow id="Flow_070_CustDone_OFDMerge" sourceRef="GW_CustDone" targetRef="GW_OFDMerge" />
    <bpmn:sequenceFlow id="Flow_071_OFDMerge_OFD" sourceRef="GW_OFDMerge" targetRef="Send_OFD" />
    <bpmn:sequenceFlow id="Flow_072_OFD_Deliver" sourceRef="Send_OFD" targetRef="UT_Deliver" />
    <bpmn:sequenceFlow id="Flow_073_Deliver_Outcome" sourceRef="UT_Deliver" targetRef="GW_Outcome" />
    <bpmn:sequenceFlow id="Flow_074_Outcome_CloseMerge" name="Delivered" sourceRef="GW_Outcome" targetRef="GW_CloseMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'delivered'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_075_Outcome_DamageMerge" name="Damage found at doorstep" sourceRef="GW_Outcome" targetRef="GW_DamageMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'damaged'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_076_Outcome_Why" name="Not delivered" sourceRef="GW_Outcome" targetRef="GW_Why">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'failed'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_077_Why_DelAttempts" name="Recipient unavailable" sourceRef="GW_Why" targetRef="GW_DelAttempts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reason == 'unavailable'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_078_Why_AddrQuery" name="Wrong address (first correction)" sourceRef="GW_Why" targetRef="Ev_AddrQuery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reason == 'address' &amp;&amp; addressCorrections &lt; 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_079_Why_RTSPre" name="Refused, COD failed or address uncorrectable" sourceRef="GW_Why" targetRef="GW_RTSPre">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reason == 'refused' || reason == 'cod' || (reason == 'address' &amp;&amp; addressCorrections &gt;= 1)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_080_DelAttempts_LoopMerge" name="Yes" sourceRef="GW_DelAttempts" targetRef="GW_LoopMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryAttempts &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_081_DelAttempts_Hold" name="No – 3 attempts used" sourceRef="GW_DelAttempts" targetRef="MT_Hold">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryAttempts &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_082_LoopMerge_OFDMerge" sourceRef="GW_LoopMerge" targetRef="GW_OFDMerge" />
    <bpmn:sequenceFlow id="Flow_083_Hold_CloseMerge" sourceRef="MT_Hold" targetRef="GW_CloseMerge" />
    <bpmn:sequenceFlow id="Flow_084_HoldTimer_RTSMerge" sourceRef="B_HoldTimer" targetRef="GW_RTSMerge" />
    <bpmn:sequenceFlow id="Flow_085_AddrQuery_NewAddr" sourceRef="Ev_AddrQuery" targetRef="UT_NewAddr" />
    <bpmn:sequenceFlow id="Flow_086_NewAddr_Surcharge" sourceRef="UT_NewAddr" targetRef="GW_Surcharge" />
    <bpmn:sequenceFlow id="Flow_087_Surcharge_Surcharge" name="Yes" sourceRef="GW_Surcharge" targetRef="Ev_Surcharge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outsideZone}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_088_Surcharge_AddrMerge" name="No" sourceRef="GW_Surcharge" targetRef="GW_AddrMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!outsideZone}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_089_Surcharge_AddrMerge" sourceRef="Ev_Surcharge" targetRef="GW_AddrMerge" />
    <bpmn:sequenceFlow id="Flow_090_AddrMerge_LoopMerge" sourceRef="GW_AddrMerge" targetRef="GW_LoopMerge" />
    <bpmn:sequenceFlow id="Flow_091_AddrTimer_RTSPre" sourceRef="B_AddrTimer" targetRef="GW_RTSPre" />
    <bpmn:sequenceFlow id="Flow_092_RTSPre_RTSMerge" sourceRef="GW_RTSPre" targetRef="GW_RTSMerge" />
    <bpmn:sequenceFlow id="Flow_093_CloseMerge_Close" sourceRef="GW_CloseMerge" targetRef="ST_Close" />
    <bpmn:sequenceFlow id="Flow_094_Close_Delivered" sourceRef="ST_Close" targetRef="End_Delivered" />
    <bpmn:sequenceFlow id="Flow_095_DamageMerge_Inspect" sourceRef="GW_DamageMerge" targetRef="UT_Inspect" />
    <bpmn:sequenceFlow id="Flow_096_Inspect_Insured" sourceRef="UT_Inspect" targetRef="GW_Insured" />
    <bpmn:sequenceFlow id="Flow_097_Insured_Uninsured" name="No" sourceRef="GW_Insured" targetRef="End_Uninsured">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!insured}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_098_Insured_Claim" name="Yes" sourceRef="GW_Insured" targetRef="SP_Claim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insured}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_099_Claim_Claim" sourceRef="SP_Claim" targetRef="End_Claim" />
    <bpmn:sequenceFlow id="Flow_100_RTSMerge_RTS" sourceRef="GW_RTSMerge" targetRef="SP_RTS" />
    <bpmn:sequenceFlow id="Flow_101_RTS_Returned" sourceRef="SP_RTS" targetRef="End_Returned" />
    <bpmn:association id="Association_B_CompCharge_ST_Refund" associationDirection="One" sourceRef="B_CompCharge" targetRef="ST_Refund" />
  </bpmn:process>
