<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StudentProjectApproval" targetNamespace="http://example.edu/bpmn/student-project-approval" exporter="hand-authored BPMN 2.0 (bpmn.io compatible)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ProjectApproval">
    <bpmn:participant id="Participant_Department" name="Student Project Approval &amp; Allocation System" processRef="Process_StudentProjectApproval" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_MissedDeadline" name="Missed-deadline notice" />
  <bpmn:message id="Msg_LapseNotice" name="Lapse notice" />
  <bpmn:message id="Msg_ClosureNotice" name="Closure notice" />
  <bpmn:message id="Msg_RejectionNotice" name="Rejection notice with reasons" />
  <bpmn:message id="Msg_ReviewReminder" name="Committee review reminder" />
  <bpmn:message id="Msg_Withdrawal" name="Team withdrawal request" />
  <bpmn:message id="Msg_WithdrawalConfirmation" name="Withdrawal confirmation" />
  <bpmn:message id="Msg_GuideUnavailable" name="Guide unavailability report" />
  <bpmn:message id="Msg_WaitlistNotice" name="Waiting-list notice" />
  <bpmn:error id="Error_InvalidTeam" name="Invalid team" errorCode="INVALID_TEAM" />
  <bpmn:error id="Error_SimilarityService" name="Similarity service unavailable" errorCode="SIMILARITY_UNAVAILABLE" />
  <bpmn:error id="Error_DatabaseWrite" name="Database write error" errorCode="DB_WRITE_ERROR" />
  <bpmn:error id="Error_Notification" name="Notification failure" errorCode="NOTIFICATION_FAILURE" />
  <bpmn:error id="Error_AllocationRecording" name="Allocation recording failed" errorCode="ALLOCATION_RECORDING_FAILED" />
  <bpmn:process id="Process_StudentProjectApproval" name="Student Project Approval &amp; Allocation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Department">
      <bpmn:lane id="Lane_Student" name="Student / Team">
        <bpmn:flowNodeRef>Start_TeamDecides</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SubmitMerge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SubmitMerge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_FlagTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_LateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_LateTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_RevTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RevLapsed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>UT_LateDecide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LateRefused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_FixEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Fixed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SimMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_SimReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SimDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ManualMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ManualAllocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Arranged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Waitlisted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ManualRecord</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>GW_ReviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_HoD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DecisionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>End_WithdrawnEarly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_GuideRespond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WithdrawEarly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_GuideTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RetryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Attempts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>ST_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TeamMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_TeamRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_TeamViolation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_SimError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Similar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_InviteMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MatchMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_GuideFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_GuideRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Exclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RecordMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Compensate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ReleaseSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_RecordError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PostMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_WindowClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_Withdrawal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompWithdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_RecordWithdrawal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_GuideUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_CompGuide</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_TeamDecides" name="Team decides to submit a proposal">
      <bpmn:outgoing>Flow_01_TeamDecides_SubmitMerge1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_SubmitMerge1">
      <bpmn:incoming>Flow_01_TeamDecides_SubmitMerge1</bpmn:incoming>
      <bpmn:incoming>Flow_07_DataValid_SubmitMerge1</bpmn:incoming>
      <bpmn:incoming>Flow_41_Invite_SubmitMerge1</bpmn:incoming>
      <bpmn:outgoing>Flow_02_SubmitMerge1_SubmitMerge2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_SubmitMerge2">
      <bpmn:incoming>Flow_02_SubmitMerge1_SubmitMerge2</bpmn:incoming>
      <bpmn:incoming>Flow_47_Late_SubmitMerge2</bpmn:incoming>
      <bpmn:outgoing>Flow_03_SubmitMerge2_Submit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Submit" name="Prepare &amp; Submit Proposal">
      <bpmn:documentation>Team fills in title, abstract, domain, roll numbers and team members in the Project Management System. Each completion increments submissionAttempts.</bpmn:documentation>
      <bpmn:incoming>Flow_03_SubmitMerge2_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Submit_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_Deadline" name="Submission deadline reached" attachedToRef="UT_Submit">
      <bpmn:outgoing>Flow_42_Deadline_FlagTeam</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_Deadline_def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${submissionDeadline}</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Ev_FlagTeam" name="Team flagged &amp; notified of missed deadline">
      <bpmn:incoming>Flow_42_Deadline_FlagTeam</bpmn:incoming>
      <bpmn:outgoing>Flow_43_FlagTeam_LateRequest</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_FlagTeam_def" messageRef="Msg_MissedDeadline" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="UT_LateRequest" name="Submit Late-Submission Request">
      <bpmn:incoming>Flow_43_FlagTeam_LateRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_44_LateRequest_LateDecide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_LateTimer" name="3 days: no request" attachedToRef="UT_LateRequest">
      <bpmn:outgoing>Flow_45_LateTimer_Lapsed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_LateTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Lapsed" name="Lapsed – deadline missed, no late request">
      <bpmn:incoming>Flow_45_LateTimer_Lapsed</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Lapsed_def" messageRef="Msg_LapseNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Revise" name="Revise &amp; Resubmit Proposal">
      <bpmn:documentation>Team addresses the committee comments. Completion increments revisionCount.</bpmn:documentation>
      <bpmn:incoming>Flow_34_Decision_Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_36_Revise_ReviewMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_RevTimer" name="7 days: no revision" attachedToRef="UT_Revise">
      <bpmn:outgoing>Flow_37_RevTimer_RevLapsed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_RevTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_RevLapsed" name="Lapsed – revision deadline missed">
      <bpmn:incoming>Flow_37_RevTimer_RevLapsed</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_RevLapsed_def" messageRef="Msg_LapseNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_LateDecide" name="Decide Late-Submission Request">
      <bpmn:incoming>Flow_44_LateRequest_LateDecide</bpmn:incoming>
      <bpmn:outgoing>Flow_46_LateDecide_Late</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Late" name="Late submission approved?">
      <bpmn:incoming>Flow_46_LateDecide_Late</bpmn:incoming>
      <bpmn:outgoing>Flow_47_Late_SubmitMerge2</bpmn:outgoing>
      <bpmn:outgoing>Flow_48_Late_LateRefused</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LateRefused" name="Lapsed – late submission refused">
      <bpmn:incoming>Flow_48_Late_LateRefused</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_LateRefused_def" messageRef="Msg_LapseNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_FixEscalated" name="Resolve Escalated Proposal Errors">
      <bpmn:documentation>Escalation target after two failed validation attempts. Coordinator works through the error list with the team.</bpmn:documentation>
      <bpmn:incoming>Flow_08_DataValid_FixEscalated</bpmn:incoming>
      <bpmn:outgoing>Flow_09_FixEscalated_Fixed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Fixed" name="Errors resolved?">
      <bpmn:incoming>Flow_09_FixEscalated_Fixed</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Fixed_TeamMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_Fixed_InvalidData</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_InvalidData" name="Closed – invalid proposal data">
      <bpmn:incoming>Flow_11_Fixed_InvalidData</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_InvalidData_def" messageRef="Msg_ClosureNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_Screen" name="Screen Proposal">
      <bpmn:documentation>Coordinator checks scope, domain tagging and format before the automated similarity check.</bpmn:documentation>
      <bpmn:incoming>Flow_14_Team_Screen</bpmn:incoming>
      <bpmn:outgoing>Flow_17_Screen_Similarity</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_SimMerge">
      <bpmn:incoming>Flow_20_Similar_SimMerge</bpmn:incoming>
      <bpmn:incoming>Flow_21_SimError_SimMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_22_SimMerge_SimReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_SimReview" name="Review Similarity Match &amp; Record Outcome">
      <bpmn:documentation>Coordinator inspects the similarity report (or checks originality manually if the service was down) and records the outcome in the system.</bpmn:documentation>
      <bpmn:incoming>Flow_22_SimMerge_SimReview</bpmn:incoming>
      <bpmn:outgoing>Flow_23_SimReview_SimDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_SimDecision" name="Coordinator decision?">
      <bpmn:incoming>Flow_23_SimReview_SimDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_24_SimDecision_ReviewMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_25_SimDecision_RejectedDuplicate</bpmn:outgoing>
      <bpmn:outgoing>Flow_26_SimDecision_InviteMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedDuplicate" name="Rejected – duplicate / plagiarised topic">
      <bpmn:incoming>Flow_25_SimDecision_RejectedDuplicate</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_RejectedDuplicate_def" messageRef="Msg_RejectionNotice" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_ManualMerge">
      <bpmn:incoming>Flow_52_GuideFound_ManualMerge</bpmn:incoming>
      <bpmn:incoming>Flow_62_Attempts_ManualMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_63_ManualMerge_ManualAllocate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_ManualAllocate" name="Allocate Guide Manually">
      <bpmn:documentation>Coordinator assigns a guide directly, appoints a co-guide or external guide, or places the team on the waiting list.</bpmn:documentation>
      <bpmn:incoming>Flow_63_ManualMerge_ManualAllocate</bpmn:incoming>
      <bpmn:outgoing>Flow_64_ManualAllocate_Arranged</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Arranged" name="Guide assigned?">
      <bpmn:incoming>Flow_64_ManualAllocate_Arranged</bpmn:incoming>
      <bpmn:outgoing>Flow_65_Arranged_RecordMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_66_Arranged_Waitlisted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Waitlisted" name="Closed – team on guide waiting list">
      <bpmn:incoming>Flow_66_Arranged_Waitlisted</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Waitlisted_def" messageRef="Msg_WaitlistNotice" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_ManualRecord" name="Record Allocation &amp; Notify Parties Manually">
      <bpmn:incoming>Flow_70_RecordError_ManualRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_71_ManualRecord_PostMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ReviewMerge">
      <bpmn:incoming>Flow_19_Similar_ReviewMerge</bpmn:incoming>
      <bpmn:incoming>Flow_24_SimDecision_ReviewMerge</bpmn:incoming>
      <bpmn:incoming>Flow_36_Revise_ReviewMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_27_ReviewMerge_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Review" name="Evaluate Proposal">
      <bpmn:incoming>Flow_27_ReviewMerge_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_28_Review_DecisionMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_Reminder" name="5 days: no decision" cancelActivity="false" attachedToRef="UT_Review">
      <bpmn:outgoing>Flow_29_Reminder_Reminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_Reminder_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Escalate" name="10 days: still no decision" attachedToRef="UT_Review">
      <bpmn:outgoing>Flow_30_Escalate_HoD</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_Escalate_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Reminder" name="Reminder sent to committee">
      <bpmn:incoming>Flow_29_Reminder_Reminder</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Reminder_def" messageRef="Msg_ReviewReminder" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_HoD" name="Decide Escalated Proposal (HoD)">
      <bpmn:incoming>Flow_30_Escalate_HoD</bpmn:incoming>
      <bpmn:outgoing>Flow_31_HoD_DecisionMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_DecisionMerge">
      <bpmn:incoming>Flow_28_Review_DecisionMerge</bpmn:incoming>
      <bpmn:incoming>Flow_31_HoD_DecisionMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_32_DecisionMerge_Decision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Decision" name="Committee decision?">
      <bpmn:incoming>Flow_32_DecisionMerge_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_33_Decision_MatchMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_34_Decision_Revise</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_Decision_NewTopic</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_WithdrawnEarly" name="Withdrawn – guide request cancelled">
      <bpmn:incoming>Flow_58_WithdrawEarly_WithdrawnEarly</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_WithdrawnEarly_def" messageRef="Msg_WithdrawalConfirmation" />
    </bpmn:endEvent>
    <bpmn:userTask id="UT_GuideRespond" name="Accept or Decline Guide Request">
      <bpmn:incoming>Flow_53_GuideRequest_GuideRespond</bpmn:incoming>
      <bpmn:outgoing>Flow_54_GuideRespond_Response</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_WithdrawEarly" name="Team withdrawal received" attachedToRef="UT_GuideRespond">
      <bpmn:outgoing>Flow_58_WithdrawEarly_WithdrawnEarly</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_WithdrawEarly_def" messageRef="Msg_Withdrawal" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_GuideTimer" name="No response in 5 days" attachedToRef="UT_GuideRespond">
      <bpmn:outgoing>Flow_57_GuideTimer_RetryMerge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_GuideTimer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_Response" name="Guide response?">
      <bpmn:incoming>Flow_54_GuideRespond_Response</bpmn:incoming>
      <bpmn:outgoing>Flow_55_Response_RecordMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_56_Response_RetryMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_RetryMerge">
      <bpmn:incoming>Flow_56_Response_RetryMerge</bpmn:incoming>
      <bpmn:incoming>Flow_57_GuideTimer_RetryMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_59_RetryMerge_Attempts</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Attempts" name="Attempts &lt; 3?">
      <bpmn:incoming>Flow_59_RetryMerge_Attempts</bpmn:incoming>
      <bpmn:outgoing>Flow_60_Attempts_Exclude</bpmn:outgoing>
      <bpmn:outgoing>Flow_62_Attempts_ManualMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_Validate" name="Validate Proposal Data">
      <bpmn:documentation>Automated check of mandatory fields, abstract and roll-number format. Produces an error list.</bpmn:documentation>
      <bpmn:incoming>Flow_04_Submit_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_05_Validate_DataValid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_DataValid" name="Data complete &amp; valid?">
      <bpmn:incoming>Flow_05_Validate_DataValid</bpmn:incoming>
      <bpmn:outgoing>Flow_06_DataValid_TeamMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_07_DataValid_SubmitMerge1</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_DataValid_FixEscalated</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_TeamMerge">
      <bpmn:incoming>Flow_06_DataValid_TeamMerge</bpmn:incoming>
      <bpmn:incoming>Flow_10_Fixed_TeamMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_12_TeamMerge_TeamRules</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BRT_TeamRules" name="Check Team Rules">
      <bpmn:documentation>Decision table: team size within limit; no member already registered in another team.</bpmn:documentation>
      <bpmn:incoming>Flow_12_TeamMerge_TeamRules</bpmn:incoming>
      <bpmn:outgoing>Flow_13_TeamRules_Team</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Team" name="Team rules satisfied?">
      <bpmn:incoming>Flow_13_TeamRules_Team</bpmn:incoming>
      <bpmn:outgoing>Flow_14_Team_Screen</bpmn:outgoing>
      <bpmn:outgoing>Flow_15_Team_TeamViolation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_TeamViolation" name="Notify Team of Rule Violation">
      <bpmn:incoming>Flow_15_Team_TeamViolation</bpmn:incoming>
      <bpmn:outgoing>Flow_16_TeamViolation_InvalidTeam</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_InvalidTeam" name="Invalid team">
      <bpmn:incoming>Flow_16_TeamViolation_InvalidTeam</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_InvalidTeam_def" errorRef="Error_InvalidTeam" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_Similarity" name="Run Similarity / Duplicate-Topic Check">
      <bpmn:incoming>Flow_17_Screen_Similarity</bpmn:incoming>
      <bpmn:outgoing>Flow_18_Similarity_Similar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_SimError" name="Similarity service unavailable" attachedToRef="ST_Similarity">
      <bpmn:outgoing>Flow_21_SimError_SimMerge</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_SimError_def" errorRef="Error_SimilarityService" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_Similar" name="Similarity above threshold?">
      <bpmn:incoming>Flow_18_Similarity_Similar</bpmn:incoming>
      <bpmn:outgoing>Flow_19_Similar_ReviewMerge</bpmn:outgoing>
      <bpmn:outgoing>Flow_20_Similar_SimMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_NewTopic" name="New-topic submission still allowed?">
      <bpmn:incoming>Flow_35_Decision_NewTopic</bpmn:incoming>
      <bpmn:outgoing>Flow_38_NewTopic_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_39_NewTopic_InviteMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Rejected – reasons sent to team">
      <bpmn:incoming>Flow_38_NewTopic_Rejected</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Rejected_def" messageRef="Msg_RejectionNotice" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_InviteMerge">
      <bpmn:incoming>Flow_26_SimDecision_InviteMerge</bpmn:incoming>
      <bpmn:incoming>Flow_39_NewTopic_InviteMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_40_InviteMerge_Invite</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_Invite" name="Send Reasons &amp; Invite Topic Resubmission">
      <bpmn:documentation>Sends committee / coordinator reasons, resets submissionAttempts and sets a new submissionDeadline (7 days).</bpmn:documentation>
      <bpmn:incoming>Flow_40_InviteMerge_Invite</bpmn:incoming>
      <bpmn:outgoing>Flow_41_Invite_SubmitMerge1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_MatchMerge">
      <bpmn:incoming>Flow_33_Decision_MatchMerge</bpmn:incoming>
      <bpmn:incoming>Flow_61_Exclude_MatchMerge</bpmn:incoming>
      <bpmn:incoming>Flow_81_CompGuide_MatchMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_49_MatchMerge_Match</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BRT_Match" name="Match Guide by Domain &amp; Workload">
      <bpmn:documentation>Decision table over domain match and current workload against the maximum load, ignoring excluded guides. Returns a guide or &quot;none&quot;.</bpmn:documentation>
      <bpmn:incoming>Flow_49_MatchMerge_Match</bpmn:incoming>
      <bpmn:outgoing>Flow_50_Match_GuideFound</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_GuideFound" name="Eligible guide found?">
      <bpmn:incoming>Flow_50_Match_GuideFound</bpmn:incoming>
      <bpmn:outgoing>Flow_51_GuideFound_GuideRequest</bpmn:outgoing>
      <bpmn:outgoing>Flow_52_GuideFound_ManualMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_GuideRequest" name="Send Allocation Request to Guide">
      <bpmn:incoming>Flow_51_GuideFound_GuideRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_53_GuideRequest_GuideRespond</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="ST_Exclude" name="Exclude Guide &amp; Count Attempt">
      <bpmn:incoming>Flow_60_Attempts_Exclude</bpmn:incoming>
      <bpmn:outgoing>Flow_61_Exclude_MatchMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_RecordMerge">
      <bpmn:incoming>Flow_55_Response_RecordMerge</bpmn:incoming>
      <bpmn:incoming>Flow_65_Arranged_RecordMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_67_RecordMerge_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_Reserve" name="Allocate Guide &amp; Reserve Slot">
      <bpmn:documentation>Commits the allocation and consumes one unit of the guide workload. Compensated by &quot;Release Guide Slot&quot;.</bpmn:documentation>
      <bpmn:incoming>Flow_67_RecordMerge_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_68_Reserve_Record</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B_Compensate" name="Undo allocation" attachedToRef="ST_Reserve">
      <bpmn:compensateEventDefinition id="B_Compensate_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ST_ReleaseSlot" name="Release Guide Slot" isForCompensation="true" />
    <bpmn:subProcess id="SP_Record" name="Record Allocation &amp; Notify Parties">
      <bpmn:incoming>Flow_68_Reserve_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_69_Record_PostMerge</bpmn:outgoing>
      <bpmn:startEvent id="SP_Start" name="Allocation committed">
        <bpmn:outgoing>Flow_82_Start_MergeDb</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP_MergeDb">
        <bpmn:incoming>Flow_82_Start_MergeDb</bpmn:incoming>
        <bpmn:incoming>Flow_87_WaitDb_MergeDb</bpmn:incoming>
        <bpmn:outgoing>Flow_83_MergeDb_WriteDb</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="SP_WriteDb" name="Write Allocation Record">
        <bpmn:incoming>Flow_83_MergeDb_WriteDb</bpmn:incoming>
        <bpmn:outgoing>Flow_84_WriteDb_Split</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="SP_B_DbError" name="Database write error" attachedToRef="SP_WriteDb">
        <bpmn:outgoing>Flow_85_B_DbError_GwDbRetry</bpmn:outgoing>
        <bpmn:errorEventDefinition id="SP_B_DbError_def" errorRef="Error_DatabaseWrite" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="SP_GwDbRetry" name="DB retries &lt; 3?">
        <bpmn:incoming>Flow_85_B_DbError_GwDbRetry</bpmn:incoming>
        <bpmn:outgoing>Flow_86_GwDbRetry_WaitDb</bpmn:outgoing>
        <bpmn:outgoing>Flow_88_GwDbRetry_ErrDb</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="SP_WaitDb" name="Wait 5 min">
        <bpmn:incoming>Flow_86_GwDbRetry_WaitDb</bpmn:incoming>
        <bpmn:outgoing>Flow_87_WaitDb_MergeDb</bpmn:outgoing>
        <bpmn:timerEventDefinition id="SP_WaitDb_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="SP_ErrDb" name="Recording failed">
        <bpmn:incoming>Flow_88_GwDbRetry_ErrDb</bpmn:incoming>
        <bpmn:errorEventDefinition id="SP_ErrDb_def" errorRef="Error_AllocationRecording" />
      </bpmn:endEvent>
      <bpmn:parallelGateway id="SP_Split">
        <bpmn:incoming>Flow_84_WriteDb_Split</bpmn:incoming>
        <bpmn:outgoing>Flow_89_Split_MergeTeam</bpmn:outgoing>
        <bpmn:outgoing>Flow_96_Split_MergeGuide</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="SP_MergeTeam">
        <bpmn:incoming>Flow_89_Split_MergeTeam</bpmn:incoming>
        <bpmn:incoming>Flow_94_WaitTeam_MergeTeam</bpmn:incoming>
        <bpmn:outgoing>Flow_90_MergeTeam_NotifyTeam</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP_NotifyTeam" name="Notify Student Team">
        <bpmn:incoming>Flow_90_MergeTeam_NotifyTeam</bpmn:incoming>
        <bpmn:outgoing>Flow_91_NotifyTeam_Join</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="SP_B_TeamError" name="Notification failure" attachedToRef="SP_NotifyTeam">
        <bpmn:outgoing>Flow_92_B_TeamError_GwTeamRetry</bpmn:outgoing>
        <bpmn:errorEventDefinition id="SP_B_TeamError_def" errorRef="Error_Notification" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="SP_GwTeamRetry" name="Retries &lt; 3?">
        <bpmn:incoming>Flow_92_B_TeamError_GwTeamRetry</bpmn:incoming>
        <bpmn:outgoing>Flow_93_GwTeamRetry_WaitTeam</bpmn:outgoing>
        <bpmn:outgoing>Flow_95_GwTeamRetry_ErrTeam</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="SP_WaitTeam" name="Wait 5 min">
        <bpmn:incoming>Flow_93_GwTeamRetry_WaitTeam</bpmn:incoming>
        <bpmn:outgoing>Flow_94_WaitTeam_MergeTeam</bpmn:outgoing>
        <bpmn:timerEventDefinition id="SP_WaitTeam_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="SP_ErrTeam" name="Team notification failed">
        <bpmn:incoming>Flow_95_GwTeamRetry_ErrTeam</bpmn:incoming>
        <bpmn:errorEventDefinition id="SP_ErrTeam_def" errorRef="Error_AllocationRecording" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="SP_MergeGuide">
        <bpmn:incoming>Flow_96_Split_MergeGuide</bpmn:incoming>
        <bpmn:incoming>Flow_101_WaitGuide_MergeGuide</bpmn:incoming>
        <bpmn:outgoing>Flow_97_MergeGuide_NotifyGuide</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="SP_NotifyGuide" name="Notify Faculty Guide">
        <bpmn:incoming>Flow_97_MergeGuide_NotifyGuide</bpmn:incoming>
        <bpmn:outgoing>Flow_98_NotifyGuide_Join</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="SP_B_GuideError" name="Notification failure" attachedToRef="SP_NotifyGuide">
        <bpmn:outgoing>Flow_99_B_GuideError_GwGuideRetry</bpmn:outgoing>
        <bpmn:errorEventDefinition id="SP_B_GuideError_def" errorRef="Error_Notification" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="SP_GwGuideRetry" name="Retries &lt; 3?">
        <bpmn:incoming>Flow_99_B_GuideError_GwGuideRetry</bpmn:incoming>
        <bpmn:outgoing>Flow_100_GwGuideRetry_WaitGuide</bpmn:outgoing>
        <bpmn:outgoing>Flow_102_GwGuideRetry_ErrGuide</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="SP_WaitGuide" name="Wait 5 min">
        <bpmn:incoming>Flow_100_GwGuideRetry_WaitGuide</bpmn:incoming>
        <bpmn:outgoing>Flow_101_WaitGuide_MergeGuide</bpmn:outgoing>
        <bpmn:timerEventDefinition id="SP_WaitGuide_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="SP_ErrGuide" name="Guide notification failed">
        <bpmn:incoming>Flow_102_GwGuideRetry_ErrGuide</bpmn:incoming>
        <bpmn:errorEventDefinition id="SP_ErrGuide_def" errorRef="Error_AllocationRecording" />
      </bpmn:endEvent>
      <bpmn:parallelGateway id="SP_Join">
        <bpmn:incoming>Flow_91_NotifyTeam_Join</bpmn:incoming>
        <bpmn:incoming>Flow_98_NotifyGuide_Join</bpmn:incoming>
        <bpmn:outgoing>Flow_103_Join_End</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="SP_End" name="Allocation recorded &amp; parties notified">
        <bpmn:incoming>Flow_103_Join_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_82_Start_MergeDb" sourceRef="SP_Start" targetRef="SP_MergeDb" />
      <bpmn:sequenceFlow id="Flow_83_MergeDb_WriteDb" sourceRef="SP_MergeDb" targetRef="SP_WriteDb" />
      <bpmn:sequenceFlow id="Flow_84_WriteDb_Split" sourceRef="SP_WriteDb" targetRef="SP_Split" />
      <bpmn:sequenceFlow id="Flow_85_B_DbError_GwDbRetry" sourceRef="SP_B_DbError" targetRef="SP_GwDbRetry" />
      <bpmn:sequenceFlow id="Flow_86_GwDbRetry_WaitDb" name="Yes" sourceRef="SP_GwDbRetry" targetRef="SP_WaitDb">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dbRetries &lt; 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_87_WaitDb_MergeDb" sourceRef="SP_WaitDb" targetRef="SP_MergeDb" />
      <bpmn:sequenceFlow id="Flow_88_GwDbRetry_ErrDb" name="No" sourceRef="SP_GwDbRetry" targetRef="SP_ErrDb">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dbRetries &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_89_Split_MergeTeam" sourceRef="SP_Split" targetRef="SP_MergeTeam" />
      <bpmn:sequenceFlow id="Flow_90_MergeTeam_NotifyTeam" sourceRef="SP_MergeTeam" targetRef="SP_NotifyTeam" />
      <bpmn:sequenceFlow id="Flow_91_NotifyTeam_Join" sourceRef="SP_NotifyTeam" targetRef="SP_Join" />
      <bpmn:sequenceFlow id="Flow_92_B_TeamError_GwTeamRetry" sourceRef="SP_B_TeamError" targetRef="SP_GwTeamRetry" />
      <bpmn:sequenceFlow id="Flow_93_GwTeamRetry_WaitTeam" name="Yes" sourceRef="SP_GwTeamRetry" targetRef="SP_WaitTeam">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${teamNotifyRetries &lt; 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_94_WaitTeam_MergeTeam" sourceRef="SP_WaitTeam" targetRef="SP_MergeTeam" />
      <bpmn:sequenceFlow id="Flow_95_GwTeamRetry_ErrTeam" name="No" sourceRef="SP_GwTeamRetry" targetRef="SP_ErrTeam">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${teamNotifyRetries &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_96_Split_MergeGuide" sourceRef="SP_Split" targetRef="SP_MergeGuide" />
      <bpmn:sequenceFlow id="Flow_97_MergeGuide_NotifyGuide" sourceRef="SP_MergeGuide" targetRef="SP_NotifyGuide" />
      <bpmn:sequenceFlow id="Flow_98_NotifyGuide_Join" sourceRef="SP_NotifyGuide" targetRef="SP_Join" />
      <bpmn:sequenceFlow id="Flow_99_B_GuideError_GwGuideRetry" sourceRef="SP_B_GuideError" targetRef="SP_GwGuideRetry" />
      <bpmn:sequenceFlow id="Flow_100_GwGuideRetry_WaitGuide" name="Yes" sourceRef="SP_GwGuideRetry" targetRef="SP_WaitGuide">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guideNotifyRetries &lt; 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_101_WaitGuide_MergeGuide" sourceRef="SP_WaitGuide" targetRef="SP_MergeGuide" />
      <bpmn:sequenceFlow id="Flow_102_GwGuideRetry_ErrGuide" name="No" sourceRef="SP_GwGuideRetry" targetRef="SP_ErrGuide">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guideNotifyRetries &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_103_Join_End" sourceRef="SP_Join" targetRef="SP_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_RecordError" name="Retries exhausted" attachedToRef="SP_Record">
      <bpmn:outgoing>Flow_70_RecordError_ManualRecord</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_RecordError_def" errorRef="Error_AllocationRecording" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_PostMerge">
      <bpmn:incoming>Flow_69_Record_PostMerge</bpmn:incoming>
      <bpmn:incoming>Flow_71_ManualRecord_PostMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_72_PostMerge_Await</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="GW_Await" name="Await confirmation window">
      <bpmn:incoming>Flow_72_PostMerge_Await</bpmn:incoming>
      <bpmn:outgoing>Flow_73_Await_WindowClosed</bpmn:outgoing>
      <bpmn:outgoing>Flow_74_Await_Withdrawal</bpmn:outgoing>
      <bpmn:outgoing>Flow_75_Await_GuideUnavailable</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Ev_WindowClosed" name="7-day confirmation window closed">
      <bpmn:incoming>Flow_73_Await_WindowClosed</bpmn:incoming>
      <bpmn:outgoing>Flow_76_WindowClosed_Allocated</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ev_WindowClosed_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Allocated" name="Project allocated &amp; confirmed">
      <bpmn:incoming>Flow_76_WindowClosed_Allocated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Ev_Withdrawal" name="Team withdrawal received">
      <bpmn:incoming>Flow_74_Await_Withdrawal</bpmn:incoming>
      <bpmn:outgoing>Flow_77_Withdrawal_CompWithdraw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_Withdrawal_def" messageRef="Msg_Withdrawal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Ev_CompWithdraw" name="Release guide slot">
      <bpmn:incoming>Flow_77_Withdrawal_CompWithdraw</bpmn:incoming>
      <bpmn:outgoing>Flow_78_CompWithdraw_RecordWithdrawal</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_CompWithdraw_def" activityRef="ST_Reserve" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="ST_RecordWithdrawal" name="Record Withdrawal &amp; Close Project">
      <bpmn:incoming>Flow_78_CompWithdraw_RecordWithdrawal</bpmn:incoming>
      <bpmn:outgoing>Flow_79_RecordWithdrawal_Withdrawn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Withdrawn" name="Withdrawn – guide slot released">
      <bpmn:incoming>Flow_79_RecordWithdrawal_Withdrawn</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_Withdrawn_def" messageRef="Msg_WithdrawalConfirmation" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Ev_GuideUnavailable" name="Guide unavailable">
      <bpmn:incoming>Flow_75_Await_GuideUnavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_80_GuideUnavailable_CompGuide</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Ev_GuideUnavailable_def" messageRef="Msg_GuideUnavailable" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Ev_CompGuide" name="Release guide slot">
      <bpmn:incoming>Flow_80_GuideUnavailable_CompGuide</bpmn:incoming>
      <bpmn:outgoing>Flow_81_CompGuide_MatchMerge</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Ev_CompGuide_def" activityRef="ST_Reserve" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_01_TeamDecides_SubmitMerge1" sourceRef="Start_TeamDecides" targetRef="GW_SubmitMerge1" />
    <bpmn:sequenceFlow id="Flow_02_SubmitMerge1_SubmitMerge2" sourceRef="GW_SubmitMerge1" targetRef="GW_SubmitMerge2" />
    <bpmn:sequenceFlow id="Flow_03_SubmitMerge2_Submit" sourceRef="GW_SubmitMerge2" targetRef="UT_Submit" />
    <bpmn:sequenceFlow id="Flow_04_Submit_Validate" sourceRef="UT_Submit" targetRef="ST_Validate" />
    <bpmn:sequenceFlow id="Flow_05_Validate_DataValid" sourceRef="ST_Validate" targetRef="GW_DataValid" />
    <bpmn:sequenceFlow id="Flow_06_DataValid_TeamMerge" name="Yes" sourceRef="GW_DataValid" targetRef="GW_TeamMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dataValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_DataValid_SubmitMerge1" name="No – return error list (attempts &lt; 2)" sourceRef="GW_DataValid" targetRef="GW_SubmitMerge1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!dataValid &amp;&amp; submissionAttempts &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08_DataValid_FixEscalated" name="No – 2 attempts used: escalate" sourceRef="GW_DataValid" targetRef="UT_FixEscalated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!dataValid &amp;&amp; submissionAttempts &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_FixEscalated_Fixed" sourceRef="UT_FixEscalated" targetRef="GW_Fixed" />
    <bpmn:sequenceFlow id="Flow_10_Fixed_TeamMerge" name="Yes" sourceRef="GW_Fixed" targetRef="GW_TeamMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorsResolved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11_Fixed_InvalidData" name="No" sourceRef="GW_Fixed" targetRef="End_InvalidData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!errorsResolved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12_TeamMerge_TeamRules" sourceRef="GW_TeamMerge" targetRef="BRT_TeamRules" />
    <bpmn:sequenceFlow id="Flow_13_TeamRules_Team" sourceRef="BRT_TeamRules" targetRef="GW_Team" />
    <bpmn:sequenceFlow id="Flow_14_Team_Screen" name="Yes" sourceRef="GW_Team" targetRef="UT_Screen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${teamValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15_Team_TeamViolation" name="No – size limit / member in another team" sourceRef="GW_Team" targetRef="Send_TeamViolation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!teamValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16_TeamViolation_InvalidTeam" sourceRef="Send_TeamViolation" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="Flow_17_Screen_Similarity" sourceRef="UT_Screen" targetRef="ST_Similarity" />
    <bpmn:sequenceFlow id="Flow_18_Similarity_Similar" sourceRef="ST_Similarity" targetRef="GW_Similar" />
    <bpmn:sequenceFlow id="Flow_19_Similar_ReviewMerge" name="No" sourceRef="GW_Similar" targetRef="GW_ReviewMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${similarityScore &lt;= threshold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20_Similar_SimMerge" name="Yes" sourceRef="GW_Similar" targetRef="GW_SimMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${similarityScore &gt; threshold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21_SimError_SimMerge" sourceRef="B_SimError" targetRef="GW_SimMerge" />
    <bpmn:sequenceFlow id="Flow_22_SimMerge_SimReview" sourceRef="GW_SimMerge" targetRef="UT_SimReview" />
    <bpmn:sequenceFlow id="Flow_23_SimReview_SimDecision" sourceRef="UT_SimReview" targetRef="GW_SimDecision" />
    <bpmn:sequenceFlow id="Flow_24_SimDecision_ReviewMerge" name="Cleared" sourceRef="GW_SimDecision" targetRef="GW_ReviewMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${simOutcome == 'cleared'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25_SimDecision_RejectedDuplicate" name="Reject (or topic already modified once)" sourceRef="GW_SimDecision" targetRef="End_RejectedDuplicate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${simOutcome == 'reject' || (simOutcome == 'modify' &amp;&amp; topicModifications &gt;= 1)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26_SimDecision_InviteMerge" name="Modify topic (first time)" sourceRef="GW_SimDecision" targetRef="GW_InviteMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${simOutcome == 'modify' &amp;&amp; topicModifications &lt; 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27_ReviewMerge_Review" sourceRef="GW_ReviewMerge" targetRef="UT_Review" />
    <bpmn:sequenceFlow id="Flow_28_Review_DecisionMerge" sourceRef="UT_Review" targetRef="GW_DecisionMerge" />
    <bpmn:sequenceFlow id="Flow_29_Reminder_Reminder" sourceRef="B_Reminder" targetRef="End_Reminder" />
    <bpmn:sequenceFlow id="Flow_30_Escalate_HoD" sourceRef="B_Escalate" targetRef="UT_HoD" />
    <bpmn:sequenceFlow id="Flow_31_HoD_DecisionMerge" sourceRef="UT_HoD" targetRef="GW_DecisionMerge" />
    <bpmn:sequenceFlow id="Flow_32_DecisionMerge_Decision" sourceRef="GW_DecisionMerge" targetRef="GW_Decision" />
    <bpmn:sequenceFlow id="Flow_33_Decision_MatchMerge" name="Approved" sourceRef="GW_Decision" targetRef="GW_MatchMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'approve'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_34_Decision_Revise" name="Revision requested (cycles &lt; 2)" sourceRef="GW_Decision" targetRef="UT_Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'revise' &amp;&amp; revisionCount &lt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35_Decision_NewTopic" name="Rejected (or 2 revision cycles used)" sourceRef="GW_Decision" targetRef="GW_NewTopic">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'reject' || (decision == 'revise' &amp;&amp; revisionCount &gt;= 2)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_36_Revise_ReviewMerge" sourceRef="UT_Revise" targetRef="GW_ReviewMerge" />
    <bpmn:sequenceFlow id="Flow_37_RevTimer_RevLapsed" sourceRef="B_RevTimer" targetRef="End_RevLapsed" />
    <bpmn:sequenceFlow id="Flow_38_NewTopic_Rejected" name="No" sourceRef="GW_NewTopic" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${newTopicSubmissions &gt;= 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_39_NewTopic_InviteMerge" name="Yes – one new topic" sourceRef="GW_NewTopic" targetRef="GW_InviteMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${newTopicSubmissions &lt; 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_40_InviteMerge_Invite" sourceRef="GW_InviteMerge" targetRef="Send_Invite" />
    <bpmn:sequenceFlow id="Flow_41_Invite_SubmitMerge1" sourceRef="Send_Invite" targetRef="GW_SubmitMerge1" />
    <bpmn:sequenceFlow id="Flow_42_Deadline_FlagTeam" sourceRef="B_Deadline" targetRef="Ev_FlagTeam" />
    <bpmn:sequenceFlow id="Flow_43_FlagTeam_LateRequest" sourceRef="Ev_FlagTeam" targetRef="UT_LateRequest" />
    <bpmn:sequenceFlow id="Flow_44_LateRequest_LateDecide" sourceRef="UT_LateRequest" targetRef="UT_LateDecide" />
    <bpmn:sequenceFlow id="Flow_45_LateTimer_Lapsed" sourceRef="B_LateTimer" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="Flow_46_LateDecide_Late" sourceRef="UT_LateDecide" targetRef="GW_Late" />
    <bpmn:sequenceFlow id="Flow_47_Late_SubmitMerge2" name="Approved (one extension only)" sourceRef="GW_Late" targetRef="GW_SubmitMerge2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lateApproved &amp;&amp; extensionsGranted &lt; 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_48_Late_LateRefused" name="Refused" sourceRef="GW_Late" targetRef="End_LateRefused">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!lateApproved || extensionsGranted &gt;= 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_49_MatchMerge_Match" sourceRef="GW_MatchMerge" targetRef="BRT_Match" />
    <bpmn:sequenceFlow id="Flow_50_Match_GuideFound" sourceRef="BRT_Match" targetRef="GW_GuideFound" />
    <bpmn:sequenceFlow id="Flow_51_GuideFound_GuideRequest" name="Yes" sourceRef="GW_GuideFound" targetRef="Send_GuideRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guide != 'none'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_52_GuideFound_ManualMerge" name="No – &quot;none&quot; (domain mismatch / max load)" sourceRef="GW_GuideFound" targetRef="GW_ManualMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guide == 'none'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_53_GuideRequest_GuideRespond" sourceRef="Send_GuideRequest" targetRef="UT_GuideRespond" />
    <bpmn:sequenceFlow id="Flow_54_GuideRespond_Response" sourceRef="UT_GuideRespond" targetRef="GW_Response" />
    <bpmn:sequenceFlow id="Flow_55_Response_RecordMerge" name="Accepted" sourceRef="GW_Response" targetRef="GW_RecordMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guideAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_56_Response_RetryMerge" name="Declined" sourceRef="GW_Response" targetRef="GW_RetryMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!guideAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_57_GuideTimer_RetryMerge" sourceRef="B_GuideTimer" targetRef="GW_RetryMerge" />
    <bpmn:sequenceFlow id="Flow_58_WithdrawEarly_WithdrawnEarly" sourceRef="B_WithdrawEarly" targetRef="End_WithdrawnEarly" />
    <bpmn:sequenceFlow id="Flow_59_RetryMerge_Attempts" sourceRef="GW_RetryMerge" targetRef="GW_Attempts" />
    <bpmn:sequenceFlow id="Flow_60_Attempts_Exclude" name="Yes – try next guide" sourceRef="GW_Attempts" targetRef="ST_Exclude">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allocationAttempts &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_61_Exclude_MatchMerge" sourceRef="ST_Exclude" targetRef="GW_MatchMerge" />
    <bpmn:sequenceFlow id="Flow_62_Attempts_ManualMerge" name="No – 3 attempts used" sourceRef="GW_Attempts" targetRef="GW_ManualMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allocationAttempts &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_63_ManualMerge_ManualAllocate" sourceRef="GW_ManualMerge" targetRef="UT_ManualAllocate" />
    <bpmn:sequenceFlow id="Flow_64_ManualAllocate_Arranged" sourceRef="UT_ManualAllocate" targetRef="GW_Arranged" />
    <bpmn:sequenceFlow id="Flow_65_Arranged_RecordMerge" name="Yes – manual / co-guide / external" sourceRef="GW_Arranged" targetRef="GW_RecordMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guideAssigned}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_66_Arranged_Waitlisted" name="No – waiting list" sourceRef="GW_Arranged" targetRef="End_Waitlisted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!guideAssigned}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_67_RecordMerge_Reserve" sourceRef="GW_RecordMerge" targetRef="ST_Reserve" />
    <bpmn:sequenceFlow id="Flow_68_Reserve_Record" sourceRef="ST_Reserve" targetRef="SP_Record" />
    <bpmn:sequenceFlow id="Flow_69_Record_PostMerge" sourceRef="SP_Record" targetRef="GW_PostMerge" />
    <bpmn:sequenceFlow id="Flow_70_RecordError_ManualRecord" sourceRef="B_RecordError" targetRef="UT_ManualRecord" />
    <bpmn:sequenceFlow id="Flow_71_ManualRecord_PostMerge" sourceRef="UT_ManualRecord" targetRef="GW_PostMerge" />
    <bpmn:sequenceFlow id="Flow_72_PostMerge_Await" sourceRef="GW_PostMerge" targetRef="GW_Await" />
    <bpmn:sequenceFlow id="Flow_73_Await_WindowClosed" sourceRef="GW_Await" targetRef="Ev_WindowClosed" />
    <bpmn:sequenceFlow id="Flow_74_Await_Withdrawal" sourceRef="GW_Await" targetRef="Ev_Withdrawal" />
    <bpmn:sequenceFlow id="Flow_75_Await_GuideUnavailable" sourceRef="GW_Await" targetRef="Ev_GuideUnavailable" />
    <bpmn:sequenceFlow id="Flow_76_WindowClosed_Allocated" sourceRef="Ev_WindowClosed" targetRef="End_Allocated" />
    <bpmn:sequenceFlow id="Flow_77_Withdrawal_CompWithdraw" sourceRef="Ev_Withdrawal" targetRef="Ev_CompWithdraw" />
    <bpmn:sequenceFlow id="Flow_78_CompWithdraw_RecordWithdrawal" sourceRef="Ev_CompWithdraw" targetRef="ST_RecordWithdrawal" />
    <bpmn:sequenceFlow id="Flow_79_RecordWithdrawal_Withdrawn" sourceRef="ST_RecordWithdrawal" targetRef="End_Withdrawn" />
    <bpmn:sequenceFlow id="Flow_80_GuideUnavailable_CompGuide" sourceRef="Ev_GuideUnavailable" targetRef="Ev_CompGuide" />
    <bpmn:sequenceFlow id="Flow_81_CompGuide_MatchMerge" sourceRef="Ev_CompGuide" targetRef="GW_MatchMerge" />
    <bpmn:association id="Association_Compensation" associationDirection="One" sourceRef="B_Compensate" targetRef="ST_ReleaseSlot" />
  </bpmn:process>
